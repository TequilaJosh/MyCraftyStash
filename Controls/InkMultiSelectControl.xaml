<UserControl x:Class="MyCraftyStash.Controls.InkMultiSelectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MyCraftyStash.Converters"
             xmlns:controls="clr-namespace:MyCraftyStash.Controls"
             x:Name="Root"
             MinHeight="56" Margin="6">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:LazyThumbnailConverter x:Key="LazyThumbnailConverter"/>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="OpenToggle"
                      IsChecked="{Binding IsOpen, Mode=TwoWay}"
                      ClickMode="Press"
                      Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2" CornerRadius="22" Padding="14,10">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding PlaceholderText, ElementName=Root}"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisConverter}}"/>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding DisplaySummary}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380"
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="InkPopup"
               PlacementTarget="{Binding ElementName=OpenToggle}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=OpenToggle, Mode=TwoWay}"
               AllowsTransparency="True" Focusable="True"
               PopupAnimation="Slide"
               Opened="InkPopup_Opened"
               Closed="InkPopup_Closed">
            <Border MinWidth="{Binding ActualWidth, ElementName=OpenToggle}"
                    MaxWidth="520"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2" CornerRadius="14" Margin="0,4,0,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- chip strip (Was this embossed? + ordered preview) -->
                        <RowDefinition Height="Auto"/>  <!-- search box -->
                        <RowDefinition Height="*"/>     <!-- ink rows -->
                        <RowDefinition Height="Auto"/>  <!-- Confirm row -->
                    </Grid.RowDefinitions>

                    <!-- Top chip strip: optional "Was this embossed?" + "Custom Color"
                         (revealed when watercolors are loaded) + ordered selection preview -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <WrapPanel>
                            <ToggleButton IsChecked="{Binding IsEmbossed, Mode=TwoWay}"
                                          Visibility="{Binding ShowEmbossedChip, ElementName=Root, Converter={StaticResource BoolToVisConverter}}"
                                          Margin="0,0,4,4" Padding="10,4" FontSize="11" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Margin="0,0,4,0"
                                                   Visibility="{Binding IsEmbossed, Converter={StaticResource BoolToVisConverter}}"/>
                                        <TextBlock Text="Was this embossed?"/>
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>

                            <!-- Custom Color: toggling reveals the watercolor list below the
                                 ink rows so the user can blend ink + watercolor picks freely. -->
                            <ToggleButton IsChecked="{Binding IsCustomColorMode, Mode=TwoWay}"
                                          Visibility="{Binding HasWatercolorOptions, Converter={StaticResource BoolToVisConverter}}"
                                          Margin="0,0,4,4" Padding="10,4" FontSize="11" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Style>
                                </ToggleButton.Style>
                                <ToggleButton.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Margin="0,0,4,0"
                                                   Visibility="{Binding IsCustomColorMode, Converter={StaticResource BoolToVisConverter}}"/>
                                        <TextBlock Text="Custom Color"/>
                                    </StackPanel>
                                </ToggleButton.Content>
                            </ToggleButton>
                        </WrapPanel>
                        <Border Padding="8,6" Margin="0,4,0,0"
                                Background="{DynamicResource SidebarBrush}"
                                CornerRadius="8"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap">
                                <Run Text="In order: " FontWeight="SemiBold"/>
                                <Run Text="{Binding DisplaySummary, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Search box: filters Chips + WatercolorChips by Color contains. -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="12" Margin="0,0,0,6"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             Tag="Search inks…"/>

                    <!-- Scrollable ink rows: thumbnail + name + checkbox indicator.
                         When Custom Color mode is active, watercolor rows render below
                         a small section header so the user can pick from both lists. -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <ScrollViewer.Resources>
                            <!-- Shared row template used by both the ink + watercolor lists. -->
                            <DataTemplate x:Key="ChipRowTemplate">
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,1" Padding="6"
                                              HorizontalContentAlignment="Stretch"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="RowBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="44" Height="44"
                                                            Background="{DynamicResource SidebarBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Image controls:ThumbnailLoader.ItemId="{Binding ItemId}"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Color}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border x:Name="CheckBox" Grid.Column="2"
                                                            Width="20" Height="20"
                                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                                            BorderThickness="1.5" CornerRadius="4"
                                                            Background="Transparent"
                                                            Margin="8,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="CheckMark" Text="✓"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="White"
                                                                   Visibility="Collapsed"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DataTemplate>
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FilteredChips}"
                                          ItemTemplate="{StaticResource ChipRowTemplate}"/>

                            <!-- Watercolor section header + rows, only shown in Custom Color mode -->
                            <StackPanel Visibility="{Binding IsCustomColorMode, Converter={StaticResource BoolToVisConverter}}">
                                <Border Margin="0,8,0,4" Padding="6,3"
                                        Background="{DynamicResource SidebarBrush}"
                                        CornerRadius="6">
                                    <TextBlock Text="Watercolors"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding FilteredWatercolorChips}"
                                              ItemTemplate="{StaticResource ChipRowTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom row: Clear (when there's a selection) + Confirm Inks -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Clear"
                                Click="ClearButton_Click"
                                Padding="10,6" FontSize="11"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Grid.Column="1" Content="Confirm Inks"
                                Command="{Binding ConfirmAndCloseCommand}"
                                Padding="14,8" FontSize="13" FontWeight="SemiBold"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
