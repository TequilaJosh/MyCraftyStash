<UserControl x:Class="MyCraftyStash.Controls.ZoomableImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="Transparent">
    <Grid x:Name="ContainerGrid" ClipToBounds="True" Background="Transparent">
        <Image x:Name="InnerImage"
               Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}"
               RenderTransformOrigin="0.5,0.5"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="ImgTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>
