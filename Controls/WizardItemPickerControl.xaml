<UserControl x:Class="MyCraftyStash.Controls.WizardItemPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MyCraftyStash.Converters"
             xmlns:controls="clr-namespace:MyCraftyStash.Controls"
             x:Name="Root"
             MinHeight="56" Margin="6">
    <UserControl.Resources>
        <converters:LazyThumbnailConverter x:Key="LazyThumbnailConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:StringEqualsMultiConverter x:Key="StringEqualsMultiConverter"/>
        <converters:ItemInCollectionToVisConverter x:Key="ItemInCollectionToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Trigger button - looks identical to a HubButton.
             IsChecked is intentionally NOT bound to the picker VM's IsOpen.
             Multiple controls can share the same picker VM (the same picker is
             reused on the Details tab and inside Section 4 of the wizard); a
             shared IsOpen would make every instance's popup fly open at once.
             Open state lives on the toggle locally; code-behind closes it
             directly after selection. -->
        <ToggleButton x:Name="OpenToggle"
                      ClickMode="Press"
                      Background="{DynamicResource CardBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="22" Padding="14,10">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Text="{Binding PlaceholderText, ElementName=Root}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedLabel"
                                       Text="{Binding DisplayLabel}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <!-- When something is selected (single-select SelectedItem or
                             multi-select SelectedItems non-empty), show value label
                             AND surface the primary-color border as a "filled in" cue. -->
                        <DataTrigger Binding="{Binding HasSelection}" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="SelectedLabel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <!-- Popup with chip strip + search + filtered item list.
             Open state is two-way bound to the toggle. StaysOpen is intentionally
             True (default) — outside-click close is handled by the Window-level
             PreviewMouseDown handler installed in Opened. With StaysOpen=False the
             toggle re-opened the popup on the same press: outside-click would
             close it, then ClickMode=Press would flip IsChecked back to true. -->
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=OpenToggle}"
               Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=OpenToggle, Mode=TwoWay}"
               AllowsTransparency="True" Focusable="True"
               PopupAnimation="Slide"
               Opened="PickerPopup_Opened"
               Closed="PickerPopup_Closed">
            <Border MinWidth="{Binding ActualWidth, ElementName=OpenToggle}"
                    MaxWidth="520"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2" CornerRadius="14" Margin="0,4,0,0"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chip strip: WrapPanel inside a height-capped scrollviewer (≈ 2 rows) -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="84"
                                  Visibility="{Binding HasSubtypes, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl ItemsSource="{Binding Subtypes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.SelectSubtypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,4,4" Padding="10,4"
                                            FontSize="11" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ChipBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1" CornerRadius="12"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                                <Binding Path="DataContext.ActiveSubtype" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                <Binding/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Search box -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="12"
                             Margin="0,8,0,8"/>

                    <!-- Filtered item list — virtualized so only rows currently in view
                         materialize (and only those rows fire ThumbnailLoader). Without
                         virtualization, opening a 100+-item dropdown like Cardstock would
                         decode every thumbnail at once (~10s). -->
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding FilteredItems}"
                                  MaxHeight="320"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectItemCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Margin="0,1" Padding="6"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="44" Height="44"
                                                    Background="{DynamicResource SidebarBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4">
                                                <Image controls:ThumbnailLoader.ItemId="{Binding Id}"
                                                       Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- Multi-select checkmark: visible when this item is in the picker's SelectedItems. -->
                                            <TextBlock Grid.Column="2" Text="✓"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryBrush}">
                                                <TextBlock.Visibility>
                                                    <MultiBinding Converter="{StaticResource ItemInCollectionToVisConverter}">
                                                        <Binding/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="DataContext.SelectedItems"/>
                                                        <Binding RelativeSource="{RelativeSource AncestorType=ItemsControl}" Path="DataContext.SelectedItems.Count"/>
                                                    </MultiBinding>
                                                </TextBlock.Visibility>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <!-- Multi-select footer: Clear (when there's a selection) +
                         Confirm Selection. Only visible when IsMultiSelect=true,
                         since single-select pickers auto-close on item click. -->
                    <Grid Grid.Row="3" Margin="0,8,0,0"
                          Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Clear"
                                Click="ClearButton_Click"
                                Padding="10,6" FontSize="11"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Grid.Column="1" Content="Confirm Selection"
                                Click="ConfirmButton_Click"
                                Padding="14,8" FontSize="13" FontWeight="SemiBold"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderThickness="0"
                                Foreground="White"
                                Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
