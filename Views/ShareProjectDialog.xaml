<Window x:Class="MyCraftyStash.Views.ShareProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share Project"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        Width="520" Height="520"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}"
                   Text="Share project"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,12" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap"
                   Text="Pick a contact to email — we'll save a .mcsproject file and open your default mail client. The recipient opens the file in their My Crafty Stash to import the project."/>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <ListBox x:Name="ContactsList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding Email}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="20"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed"
                   Text="No address book contacts have an email yet. Add an email to a contact in the Address Book first, or use Save Only to share manually."/>

        <CheckBox Grid.Row="3" x:Name="OpenInExplorerCheck"
                  Margin="0,12,0,0" IsChecked="True"
                  Content="Also open the file location in Explorer"
                  Foreground="{DynamicResource TextBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button x:Name="SaveOnlyBtn" Content="Save Only" Width="100" Height="32" Margin="0,0,8,0"
                    Click="SaveOnly_Click"/>
            <Button x:Name="SendBtn" Content="Save &amp; Email" Width="120" Height="32"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    BorderThickness="0"
                    Click="Send_Click"/>
        </StackPanel>
    </Grid>
</Window>
