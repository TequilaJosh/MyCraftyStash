<Window x:Class="MyCraftyStash.Views.CardBuildWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyCraftyStash.Converters"
        xmlns:controls="clr-namespace:MyCraftyStash.Controls"
        Title="Start Project"
        Width="1380" MinWidth="1180" MinHeight="700"
        Height="880"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:Base64ImageConverter x:Key="Base64ImageConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:LazyThumbnailConverter x:Key="LazyThumbnailConverter"/>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionSummary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Hub button - large rounded pill used in the central button grid.
             Idle = white surface + warm border. Hover = warm tan. -->
        <Style x:Key="HubButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- "Done" state: when content ends with "Done!" use crimson fill + white text -->
                <Trigger Property="Content" Value="Cardbase - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Cardstock - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Background Mat - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Focal Image - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Sentiment - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Decoration - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Details - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Inside of Card - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Cardfold - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Adhesives - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="How was it cut - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Additional Mat - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Embellishments - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="Content" Value="Focal Mat - Done!">
                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Wide pill button used for primary action under the hub grid (Create Card) -->
        <Style x:Key="HubPrimaryButton" TargetType="Button" BasedOn="{StaticResource HubButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>

        <!-- Side panel (image left, summary right) - tall rounded card -->
        <Style x:Key="HubSidePanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <!-- Small ✕ close button used inside chip strips. Cream hover. -->
        <Style x:Key="WizardCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="999"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Item template used inside every wizard dropdown: image + name, both clickable ── -->
        <DataTemplate x:Key="WizardComboBoxItemTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Image controls:ThumbnailLoader.ItemId="{Binding Id}"
                           Stretch="Uniform"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- ── ComboBox styled to look exactly like a HubButton ─────────────────
             Use Tag="Placeholder text" on the ComboBox to set the empty-state label.
             ToolTip holds the placeholder for accessibility. -->
        <ControlTemplate x:Key="WizardComboBoxToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                    BorderThickness="2" CornerRadius="22" Padding="14,10"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="WizardComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemTemplate" Value="{StaticResource WizardComboBoxItemTemplate}"/>
            <Setter Property="MaxDropDownHeight" Value="380"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource WizardComboBoxToggleTemplate}"/>
                            <!-- Selected item label / placeholder -->
                            <Grid IsHitTestVisible="False" Margin="14,10">
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Visibility="Collapsed"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="2" CornerRadius="14"
                                        Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                            <!-- When nothing is selected: show the placeholder, hide the value label. -->
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as WizardComboBox but pre-set to fill the slot of a HubButton in a UniformGrid. -->
        <Style x:Key="WizardHubComboBox" TargetType="ComboBox" BasedOn="{StaticResource WizardComboBox}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <TextBlock Text="Start Project" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <!-- Body: 3-column hub layout (left=image, middle=hub or section, right=summary) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="322"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="345"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Left: Image of project ═══════════════════════════════════════ -->
            <Border Grid.Column="0" Style="{StaticResource HubSidePanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Image when present (double-click to zoom, drag to pan, Ctrl+wheel for finer zoom) -->
                    <controls:ZoomableImage Grid.Row="0" Stretch="Uniform"
                           Visibility="{Binding HasProjectImage, Converter={StaticResource BoolToVisConverter}}"
                           Source="{Binding ProjectImageBase64, Converter={StaticResource Base64ImageConverter}}"
                           ToolTip="Double-click to zoom · drag to pan · Ctrl+wheel for finer zoom"/>
                    <!-- Placeholder text when no image -->
                    <TextBlock Grid.Row="0" Text="Image of item"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                               Visibility="{Binding HasProjectImage, Converter={StaticResource InverseBoolToVisConverter}}"/>
                    <!-- Upload button -->
                    <Button Grid.Row="1" Content="Upload / Change Image"
                            Command="{Binding UploadProjectImageCommand}"
                            HorizontalAlignment="Stretch" Padding="10,6" Margin="0,8,0,0"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Cursor="Hand" FontSize="11">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ Middle: Hub button grid OR section content ══════════════════
                 Wrapped in a ScrollViewer so mouse-wheel works anywhere over the middle
                 column — sub-pages that overflow vertically (Details with multiple
                 follow-up cards, BG mat hub, etc.) can be scrolled by hovering anywhere
                 in the middle area, not just over a specific inner ScrollViewer. -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
            <Grid>
                <!-- Hub button grid (visible when no section is active) -->
                <Grid Visibility="{Binding IsHubActive, Converter={StaticResource BoolToVisConverter}}"
                      Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Back to Project Page (oval pill) -->
                        <RowDefinition Height="Auto"/>  <!-- Inside-of-Card banner (auto-hidden) -->
                        <RowDefinition Height="Auto"/>  <!-- Hub button grid -->
                        <RowDefinition Height="Auto"/>  <!-- Create Card -->
                    </Grid.RowDefinitions>

                    <!-- Top-left back-out, mode-aware:
                         • Outside main hub → "Back to Project Page" exits the wizard.
                         • Inside hub       → "Back to Main Hub" flips IsInsideMode off
                           and returns to the outside main hub. Same visual slot, so
                           the user always has a way back without scrolling. -->
                    <Button Grid.Row="0" Style="{StaticResource BackButton}"
                            Content="← Back to Project Page"
                            Command="{Binding CancelBuildCommand}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsInsideMode, Converter={StaticResource InverseBoolToVisConverter}}"/>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}"
                            Content="← Back to Main Hub"
                            Command="{Binding ToggleInsideModeCommand}"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsInsideMode, Converter={StaticResource BoolToVisConverter}}"/>

                    <!-- Inside-of-Card banner — visible only while IsInsideMode is on. -->
                    <Border Grid.Row="1" Margin="6,0,6,12" Padding="16,12"
                            Background="{DynamicResource PrimaryBrush}" CornerRadius="14"
                            Visibility="{Binding IsInsideMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="Inside of Card" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- ═══ Outside-mode hub: 4 rows × 2 cols, 8 buttons ═══════════
                         Shown only when IsInsideMode is False. Per-button mode
                         visibility on Cardbase/Envelopes is no longer needed
                         because the entire grid is hidden when we flip modes. -->
                    <UniformGrid Grid.Row="2" Rows="4" Columns="2" VerticalAlignment="Center"
                                 Visibility="{Binding IsInsideMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <!-- Row 1: Cardbase | Sentiment -->
                        <Button Command="{Binding NavToCardBaseCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Cardbase"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardBaseSaved}" Value="True">
                                            <Setter Property="Content" Value="Cardbase - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavToSentimentCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Sentiment"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SentimentSaved}" Value="True">
                                            <Setter Property="Content" Value="Sentiment - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Row 2: Background Mat | Embellishments -->
                        <Button Command="{Binding NavToBackgroundMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Background Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BackgroundMatSaved}" Value="True">
                                            <Setter Property="Content" Value="Background Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavToEmbellishmentsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Embellishments"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmbellishmentsSaved}" Value="True">
                                            <Setter Property="Content" Value="Embellishments - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Row 3: Additional Mat | Build Inside of Card -->
                        <Button Command="{Binding NavToAdditionalMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Additional Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdditionalMatSaved}" Value="True">
                                            <Setter Property="Content" Value="Additional Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ToggleInsideModeCommand}"
                                Content="Build Inside of Card"
                                Style="{StaticResource HubButton}"/>
                        <!-- Row 4: Focal Mat | Envelopes -->
                        <Button Command="{Binding NavToFocalMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Focal Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FocalMatSaved}" Value="True">
                                            <Setter Property="Content" Value="Focal Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <controls:WizardItemPickerControl DataContext="{Binding EnvelopesPicker}"
                                                          PlaceholderText="Envelopes"/>
                    </UniformGrid>

                    <!-- ═══ Inside-mode hub: 5 rows × 2 cols, 7 buttons + wide Done ═══
                         Shown only when IsInsideMode is True. Cardstock and Details
                         buttons are stubs in Phase A; Phase B and C wire the real
                         behavior. -->
                    <Grid Grid.Row="2" VerticalAlignment="Center"
                          Visibility="{Binding IsInsideMode, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1: Cardstock (inside liner) | Sentiment -->
                        <Button Grid.Row="0" Grid.Column="0"
                                Command="{Binding NavToInsideCardstockCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Cardstock"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideCardstockSaved}" Value="True">
                                            <Setter Property="Content" Value="Cardstock - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1"
                                Command="{Binding NavToSentimentCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Sentiment"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideSentimentDone}" Value="True">
                                            <Setter Property="Content" Value="Sentiment - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Row 2: Background Mat | Embellishments -->
                        <Button Grid.Row="1" Grid.Column="0"
                                Command="{Binding NavToBackgroundMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Background Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideBackgroundMatDone}" Value="True">
                                            <Setter Property="Content" Value="Background Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1"
                                Command="{Binding NavToEmbellishmentsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Embellishments"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideEmbellishmentsDone}" Value="True">
                                            <Setter Property="Content" Value="Embellishments - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Row 3: Additional Mat | Details -->
                        <Button Grid.Row="2" Grid.Column="0"
                                Command="{Binding NavToAdditionalMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Additional Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideAdditionalMatDone}" Value="True">
                                            <Setter Property="Content" Value="Additional Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1"
                                Command="{Binding NavToInsideDetailsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Details"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideDetailsSaved}" Value="True">
                                            <Setter Property="Content" Value="Details - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Row 4: Focal Mat | (empty) -->
                        <Button Grid.Row="3" Grid.Column="0"
                                Command="{Binding NavToFocalMatCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Focal Mat"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InsideFocalMatDone}" Value="True">
                                            <Setter Property="Content" Value="Focal Mat - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Row 5: Done with Inside (spans both columns) -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                Command="{Binding ToggleInsideModeCommand}"
                                Content="Done with Inside"
                                Style="{StaticResource HubButton}"/>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="6,12,6,4">
                        <Button Style="{StaticResource HubPrimaryButton}"
                                Content="Create Card"
                                Command="{Binding ConfirmBuildCommand}"/>
                        <TextBlock Text="Notes" Margin="2,16,0,4"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource FontSm}"/>
                        <TextBox Text="{Binding WizardNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="90" VerticalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Section content (visible when a section is active).
                     PreviewMouseWheel is the single rescue point for wheel scrolling
                     across this whole subtree — nested ToggleButton-style pickers mark
                     wheel events handled on bubble, so without this the page can't be
                     scrolled. The handler defers to ComboBox / ListBox / Popup so their
                     own wheel behavior keeps working. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20"
                              PreviewMouseWheel="FollowupsScroll_PreviewMouseWheel"
                              Visibility="{Binding IsHubActive, Converter={StaticResource InverseBoolToVisConverter}}">
                    <StackPanel>

                <!-- ═══ Cardbase sub-hub (4 buttons + Save Cardbase) ════════════ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCardBaseSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsCardBaseHubStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to hub"
                            Command="{Binding BackToHubCommand}"/>
                    <UniformGrid Grid.Row="1" Rows="2" Columns="2" VerticalAlignment="Center">
                        <!-- Row 1: Cardfold | Details -->
                        <Button Command="{Binding NavCardBaseToCardfoldCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Cardfold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardFoldSaved}" Value="True">
                                            <Setter Property="Content" Value="Cardfold - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavCardBaseToDetailsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Details"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardBaseDetailsSaved}" Value="True">
                                            <Setter Property="Content" Value="Details - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Row 2: Cardstock | Adhesives -->
                        <Button Command="{Binding NavCardBaseToCardstockCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Cardstock"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardStockSaved}" Value="True">
                                            <Setter Property="Content" Value="Cardstock - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavCardBaseToAdhesivesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Adhesives"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardBaseAdhesivesSaved}" Value="True">
                                            <Setter Property="Content" Value="Adhesives - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                    <Button Grid.Row="2" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Cardbase"
                            Command="{Binding SaveCardBaseAndBackToHubCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Cardfold sub-page (7 fold buttons + Save Cardfold) ════ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCardBaseSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsCardBaseCardfoldStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to Cardbase"
                            Command="{Binding BackToCardBaseHubCommand}"/>
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Grid.Column="0"
                                 Content="A2 Top Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="A2 Top Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A2 Top Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0"
                                 Content="Mini Slim Top Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="Mini Slim Top Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Mini Slim Top Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0"
                                 Content="A2 Side Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="A2 Side Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A2 Side Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="1"
                                 Content="Mini Slim Side Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="Mini Slim Side Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Mini Slim Side Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="1"
                                 Content="A7 Top Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="A7 Top Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A7 Top Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                 Content="Fun Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="Fun Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Fun Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1"
                                 Content="A7 Side Fold" Command="{Binding SelectCardFoldCommand}" CommandParameter="A7 Side Fold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding SelectedCardBase, Converter={StaticResource StringEqualsConverter}, ConverterParameter=A7 Side Fold}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Button Grid.Row="2" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Cardfold"
                            Command="{Binding SaveCardFoldCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Cardstock sub-page (3 styled-as-button comboboxes + Save) ═ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCardBaseSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsCardBaseCardstockStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to Cardbase"
                            Command="{Binding BackToCardBaseHubCommand}"/>
                    <!-- Pickers stacked in the left column; right column intentionally
                         empty so the inline Self-blend / Confirm panels below read as
                         full-width primary actions. -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Style="{StaticResource WizardComboBox}" Tag="Cardstock"
                                  ItemsSource="{Binding BaseCardstockRegularItems}"
                                  SelectedItem="{Binding SelectedBaseRegularCardstockItem, Mode=TwoWay}"/>
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  Style="{StaticResource WizardComboBox}" Tag="Foil Cardstock"
                                  ItemsSource="{Binding BaseCardstockFoilItems}"
                                  SelectedItem="{Binding SelectedBaseFoilCardstockItem, Mode=TwoWay}"/>
                        <ComboBox Grid.Row="2" Grid.Column="0"
                                  Style="{StaticResource WizardComboBox}" Tag="Glitter Cardstock"
                                  ItemsSource="{Binding BaseCardstockGlitterItems}"
                                  SelectedItem="{Binding SelectedBaseGlitterCardstockItem, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Self-blend follow-up — collapsed by default, expands when checked.
                         Mirrors the BG mat / Sentiment Cardstock self-blend. -->
                    <Border Grid.Row="2" Padding="12" Margin="6,12,6,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <StackPanel>
                            <CheckBox Content="Self-blended cardstock"
                                      IsChecked="{Binding BaseIsSelfBlended, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,0,6" Cursor="Hand"/>
                            <StackPanel Visibility="{Binding BaseIsSelfBlended, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Description (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BaseSelfBlendDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,0,8"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <!-- Inks blended into the cardstock — multi-select, click order preserved. -->
                                <TextBlock Text="Inks used (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <controls:InkMultiSelectControl DataContext="{Binding BaseBlendInks}"
                                                                PlaceholderText="Pick blend inks..."
                                                                Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Confirm Cardstock"
                            Command="{Binding SaveCardStockCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Inside Cardstock sub-page (single picker + Save) ═══════
                     Reached from the Inside Hub's Cardstock button. Picks the
                     cardstock layered onto the inside of the card. Simpler than
                     the outside Cardbase Cardstock page (no foil/glitter
                     sub-pickers, no self-blend) — extensible later. -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInsideCardstockSectionActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}"
                            Content="← Back to Inside"
                            Command="{Binding BackToHubCommand}"/>
                    <controls:WizardItemPickerControl Grid.Row="1"
                                                      DataContext="{Binding InsideLinerCardstockPicker}"
                                                      PlaceholderText="Cardstock for inside"
                                                      Margin="6,12,6,0"/>
                    <Button Grid.Row="2" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Inside Cardstock"
                            Command="{Binding SaveInsideCardstockAndBackToHubCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Details sub-page (8 reusable pickers + Save Details) ════
                     Shared across parent contexts (Cardbase, Background Mat, …).
                     Visibility gate is the unified IsDetailsStepActive; back/save
                     button labels swap based on DetailsReturnTarget. -->
                <Grid Margin="0,0,0,8"
                      Visibility="{Binding IsDetailsStepActive, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- back button -->
                        <RowDefinition Height="Auto"/>  <!-- added-details chip strip -->
                        <RowDefinition Height="Auto"/>  <!-- picker grid -->
                        <RowDefinition Height="Auto"/>  <!-- selection details / follow-ups -->
                        <RowDefinition Height="Auto"/>  <!-- live current-selection preview -->
                        <RowDefinition Height="Auto"/>  <!-- save buttons -->
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}"
                            Content="{Binding DetailsBackButtonLabel}"
                            Command="{Binding BackFromDetailsCommand}"/>

                    <!-- ── Added-details chip strip (auto-hides when no entries) ── -->
                    <Border Grid.Row="1" Margin="6,0,6,8" Padding="10,8"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddedDetailsForCurrentTarget.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,0,0,6">
                                <Run Text="Added so far ("/><Run Text="{Binding AddedDetailsForCurrentTarget.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding AddedDetailsForCurrentTarget}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SidebarBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="10,4" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplaySummary}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="320"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplaySummary}"/>
                                                <Button Content="✕"
                                                        Style="{StaticResource WizardCloseButton}"
                                                        Command="{Binding DataContext.RemoveAddedDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20"
                                                        Margin="8,0,0,0"
                                                        ToolTip="Remove this detail"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding StampsPicker}"
                                                           PlaceholderText="Stamps"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0"
                                                          DataContext="{Binding DiesPicker}"
                                                           PlaceholderText="Dies"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="1"
                                                          DataContext="{Binding EmbellishmentsPicker}"
                                                           PlaceholderText="Embellishments"/>
                        <controls:WizardItemPickerControl Grid.Row="2" Grid.Column="0"
                                                          DataContext="{Binding StackletsPicker}"
                                                           PlaceholderText="Stacklets"/>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="1"
                                                          DataContext="{Binding EmbossingFoldersPicker}"
                                                           PlaceholderText="Embossing Folders"/>
                        <controls:WizardItemPickerControl Grid.Row="3" Grid.Column="0"
                                                          DataContext="{Binding StencilsPicker}"
                                                           PlaceholderText="Stencils"/>

                        <!-- Inks / Watercolors – mode toggle on top, then color list or watercolor item list -->
                        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" MinHeight="56" Margin="6">
                            <ToggleButton x:Name="InksWatercolorsToggle"
                                          IsChecked="{Binding InksWatercolorsIsOpen, Mode=TwoWay}"
                                          ClickMode="Press"
                                          Background="{DynamicResource CardBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Foreground="{DynamicResource TextBrush}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2"
                                                CornerRadius="22" Padding="14,10">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="380">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Inks/Watercolors"/>
                                                        <Style.Triggers>
                                                            <!-- Custom Color mode wins when it has any picks. -->
                                                            <DataTrigger Binding="{Binding DetailsInks.HasSelection}" Value="True">
                                                                <Setter Property="Text" Value="{Binding DetailsInks.DisplaySummary, StringFormat='Custom: {0}'}"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DetailsInks.HasSelection}" Value="False"/>
                                                                    <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="False"/>
                                                                    <Condition Binding="{Binding SelectedInkColor, Converter={StaticResource StringEqualsConverter}, ConverterParameter={x:Null}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="{Binding SelectedInkColor, StringFormat='Ink: {0}'}"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding DetailsInks.HasSelection}" Value="False"/>
                                                                    <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Text" Value="{Binding WatercolorsPicker.SelectedItem.Name, FallbackValue='Watercolors', TargetNullValue='Watercolors'}"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="InksWatercolorsPopup"
                                   PlacementTarget="{Binding ElementName=InksWatercolorsToggle}"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsChecked, ElementName=InksWatercolorsToggle, Mode=TwoWay}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   Opened="InksWatercolorsPopup_Opened"
                                   Closed="InksWatercolorsPopup_Closed">
                                <Border MinWidth="{Binding ActualWidth, ElementName=InksWatercolorsToggle}"
                                        MaxWidth="520"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="2" CornerRadius="14" Margin="0,4,0,0"
                                        Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- Mode chips: [Inks] [Watercolors] -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Content="Inks" Command="{Binding SetInksModeCommand}"
                                                    Margin="0,0,6,0" Padding="14,4" FontSize="12" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                                BorderThickness="1" CornerRadius="12"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="False"/>
                                                                    <Condition Binding="{Binding DetailsInks.IsCustomColorMode}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Watercolors" Command="{Binding SetWatercolorsModeCommand}"
                                                    Margin="0,0,6,0" Padding="14,4" FontSize="12" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                                BorderThickness="1" CornerRadius="12"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="True"/>
                                                                    <Condition Binding="{Binding DetailsInks.IsCustomColorMode}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Custom Color toggle: when on, hides the single-select lists
                                                 and shows the multi-select inks + watercolors below. The
                                                 chip stays highlighted while DetailsInks.IsCustomColorMode is true. -->
                                            <ToggleButton IsChecked="{Binding DetailsInks.IsCustomColorMode, Mode=TwoWay}"
                                                          Padding="14,4" FontSize="12" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                                BorderThickness="1" CornerRadius="12"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <ToggleButton.Style>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Style>
                                                </ToggleButton.Style>
                                                <ToggleButton.Content>
                                                    <TextBlock Text="Custom Color"/>
                                                </ToggleButton.Content>
                                            </ToggleButton>
                                        </StackPanel>

                                        <!-- Ink color list (visible in Inks mode, and not when Custom Color is on) -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="False"/>
                                                                <Condition Binding="{Binding DetailsInks.IsCustomColorMode}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <StackPanel>
                                                <!-- Search box: filters DetailsInks.Chips by Color contains. -->
                                                <TextBox Text="{Binding DetailsInkSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8,6" FontSize="12" Margin="0,0,0,6"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                         Tag="Search inks…"/>
                                                <ItemsControl ItemsSource="{Binding FilteredDetailsInkChips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectInkColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding Color}"
                                                                    Margin="0,1" Padding="6"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Cursor="Hand">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="48"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="44" Height="44"
                                                                            Background="{DynamicResource SidebarBrush}"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                            CornerRadius="4">
                                                                        <Image controls:ThumbnailLoader.ItemId="{Binding ItemId}"
                                                                               Stretch="Uniform"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Color}"
                                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                                               Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- Watercolor items (visible in Watercolors mode, hidden when Custom Color is on).
                                             Click a row to set WatercolorsPicker.SelectedItem and close the popup. -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding InksWatercolorsIsWatercolorMode}" Value="True"/>
                                                                <Condition Binding="{Binding DetailsInks.IsCustomColorMode}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>
                                            <ItemsControl ItemsSource="{Binding WatercolorsPicker.FilteredItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.SelectWatercolorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,1" Padding="6"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0"
                                                                Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="44" Height="44"
                                                                        Background="{DynamicResource SidebarBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                        CornerRadius="4">
                                                                    <Image controls:ThumbnailLoader.ItemId="{Binding Id}"
                                                                           Stretch="Uniform"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Custom Color multi-select: combined ink + watercolor chip rows.
                                             Visible only when DetailsInks.IsCustomColorMode is true. Picks
                                             accumulate in DetailsInks.Ordered and feed entry.InkColor on Save. -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                                      Visibility="{Binding DetailsInks.IsCustomColorMode, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel>
                                                <Border Padding="8,6" Margin="0,0,0,6"
                                                        Background="{DynamicResource SidebarBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{Binding DetailsInks.HasSelection, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="In order: " FontWeight="SemiBold"/>
                                                        <Run Text="{Binding DetailsInks.DisplaySummary, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding DetailsInks.Chips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Margin="0,1" Padding="6"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="RowBd" Background="{TemplateBinding Background}"
                                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="48"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="44" Height="44"
                                                                                        Background="{DynamicResource SidebarBrush}"
                                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                                        CornerRadius="4">
                                                                                    <Image controls:ThumbnailLoader.ItemId="{Binding ItemId}"
                                                                                           Stretch="Uniform"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Color}"
                                                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <Border x:Name="CheckBox" Grid.Column="2"
                                                                                        Width="20" Height="20"
                                                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                                                        BorderThickness="1.5" CornerRadius="4"
                                                                                        Background="Transparent"
                                                                                        Margin="8,0,4,0" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="CheckMark" Text="✓"
                                                                                               FontSize="12" FontWeight="Bold"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Foreground="White" Visibility="Collapsed"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Margin="0,8,0,4" Padding="6,3"
                                                        Background="{DynamicResource SidebarBrush}"
                                                        CornerRadius="6"
                                                        Visibility="{Binding DetailsInks.HasWatercolorOptions, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="Watercolors"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding DetailsInks.WatercolorChips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Margin="0,1" Padding="6"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border x:Name="RowBd" Background="{TemplateBinding Background}"
                                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="48"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="44" Height="44"
                                                                                        Background="{DynamicResource SidebarBrush}"
                                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                                        CornerRadius="4">
                                                                                    <Image controls:ThumbnailLoader.ItemId="{Binding ItemId}"
                                                                                           Stretch="Uniform"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Color}"
                                                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                <Border x:Name="CheckBox" Grid.Column="2"
                                                                                        Width="20" Height="20"
                                                                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                                                                        BorderThickness="1.5" CornerRadius="4"
                                                                                        Background="Transparent"
                                                                                        Margin="8,0,4,0" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="CheckMark" Text="✓"
                                                                                               FontSize="12" FontWeight="Bold"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Foreground="White" Visibility="Collapsed"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="CheckBox" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <controls:WizardItemPickerControl Grid.Row="3" Grid.Column="1"
                                                          DataContext="{Binding OloMarkersPicker}"
                                                           PlaceholderText="OLO Markers"/>
                        <controls:WizardItemPickerControl Grid.Row="2" Grid.Column="1"
                                                          DataContext="{Binding FoilsPicker}"
                                                           PlaceholderText="Foils"/>
                    </Grid>

                    <!-- ── Selection Details: per-picker follow-up questions ──────
                         Only the cards whose source picker has a selection are shown. -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                  Margin="6,12,6,0"
                                  Visibility="{Binding ShowAnyFollowups, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <!-- ── Stamp follow-ups ─────────────────────────────────── -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowStampFollowups, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Stamp details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Ink colors (in order used):"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <controls:InkMultiSelectControl DataContext="{Binding StampInks}"
                                                                    PlaceholderText="Pick inks..."
                                                                    ShowEmbossedChip="True"
                                                                    Margin="0,0,0,8"/>
                                    <StackPanel Visibility="{Binding StampInks.IsEmbossed, Converter={StaticResource BoolToVisConverter}}"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="Embossing powder:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <controls:WizardItemPickerControl DataContext="{Binding StampEmbossingPowderPicker}"
                                                                          PlaceholderText="Embossing Powder"
                                                                          Margin="0"/>
                                    </StackPanel>
                                    <!-- Die Combo branch -->
                                    <StackPanel Visibility="{Binding StampHasDieCombo, Converter={StaticResource BoolToVisConverter}}">
                                        <CheckBox Content="Did you also use the matching die? (combo)"
                                                  IsChecked="{Binding StampUsedAsCombo, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding StampUsedAsCombo, Converter={StaticResource BoolToVisConverter}}"
                                                    Margin="14,0,0,0">
                                            <TextBlock Text="How many layers?" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                       Margin="0,0,8,0"/>
                                            <TextBox Text="{Binding StampComboLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="60" Padding="6,4"
                                                     Background="{DynamicResource InputBackgroundBrush}"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── Die follow-ups ───────────────────────────────────── -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowDieFollowups, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Die details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <CheckBox Content="Did you cut multiple layers?"
                                              IsChecked="{Binding DieIsMultiLayer, Mode=TwoWay}"
                                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                                              Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DieIsMultiLayer, Converter={StaticResource BoolToVisConverter}}"
                                                Margin="14,0,0,0">
                                        <TextBlock Text="How many layers?" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding DieLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Padding="6,4"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── Embellishment / Embossing Powder follow-ups ─────── -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowEmbellEmbossingFollowups, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Embossing powder details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Ink colors (in order used):"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <controls:InkMultiSelectControl DataContext="{Binding EmbellEmbossingInks}"
                                                                    PlaceholderText="Pick inks..."
                                                                    Margin="0,0,0,8"/>
                                    <TextBlock Text="Stamp embossed:"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <controls:WizardItemPickerControl DataContext="{Binding EmbellEmbossingStampPicker}"
                                                                      PlaceholderText="Stamp embossed with this powder"
                                                                      Margin="0"/>
                                </StackPanel>
                            </Border>

                            <!-- ── Stacklet follow-ups ──────────────────────────────── -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowStackletFollowups, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Stacklet details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Which die in the set? (1 = largest)" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding StackletDieNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Padding="6,4"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="How many layers?" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                   Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding StackletLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Padding="6,4"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── Stencil follow-ups (per-layer stepper) ────────────────
                                 The picked stencil's layer count (Item.StencilLayers,
                                 fallback 1) drives a stepper: the user fills in inks +
                                 special-media flags one layer at a time, with prominent
                                 "Layer X of Y" header and a chip strip showing what's
                                 already been recorded for prior layers. -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowDetailStencilLayers, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Stencil details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Step through each stencil layer to record the ink you used."
                                               FontStyle="Italic" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <!-- Layer header: large + colored so the user can't miss
                                         which layer they're editing. -->
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10"
                                            Padding="12,8" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DetailStencilLayerHeader}"
                                                       Foreground="White"
                                                       FontSize="16" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="◀ Previous"
                                                        Command="{Binding PreviousDetailStencilLayerCommand}"
                                                        IsEnabled="{Binding HasPreviousDetailStencilLayer}"
                                                        Padding="10,4" FontSize="11"
                                                        Background="White" Foreground="{DynamicResource PrimaryBrush}"
                                                        BorderBrush="White" BorderThickness="1"
                                                        Cursor="Hand" Margin="0,0,6,0"/>
                                                <Button Content="Next ▶"
                                                        Command="{Binding NextDetailStencilLayerCommand}"
                                                        IsEnabled="{Binding HasNextDetailStencilLayer}"
                                                        Padding="10,4" FontSize="11"
                                                        Background="White" Foreground="{DynamicResource PrimaryBrush}"
                                                        BorderBrush="White" BorderThickness="1"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Progress strip: every layer's running summary so the
                                         user can see what they've recorded so far. The active
                                         layer is highlighted in cream. -->
                                    <ItemsControl ItemsSource="{Binding DetailStencilLayerEntries}" Margin="0,0,0,10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10"
                                                        Padding="8,4" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding SummaryLine}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11" TextWrapping="Wrap" MaxWidth="320"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Active-layer editor — bound to CurrentStencilLayerEntry,
                                         which swaps as the user navigates. -->
                                    <ContentControl Content="{Binding DetailStencilLayerEntry}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="Inks used on this layer:"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11" Margin="0,0,0,4"/>
                                                    <controls:InkMultiSelectControl DataContext="{Binding Inks}"
                                                                                    PlaceholderText="Pick inks for this layer..."
                                                                                    Margin="0,0,0,8"/>
                                                    <CheckBox Content="Used Glitter on this layer"
                                                              IsChecked="{Binding UsedGlitter, Mode=TwoWay}"
                                                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                              Margin="0,0,0,4" Cursor="Hand"/>
                                                    <!-- Wrapper StackPanel inherits the layer entry as its DataContext,
                                                         so its Visibility can bind directly to UsedGlitter. The inner
                                                         picker then re-points DataContext at the per-layer picker. -->
                                                    <StackPanel Margin="14,0,0,6"
                                                                Visibility="{Binding UsedGlitter, Converter={StaticResource BoolToVisConverter}}">
                                                        <controls:WizardItemPickerControl DataContext="{Binding GlitterPicker}"
                                                                                          PlaceholderText="Which glitter?"/>
                                                    </StackPanel>
                                                    <CheckBox Content="Used Happy Medium on this layer"
                                                              IsChecked="{Binding UsedHappyMedium, Mode=TwoWay}"
                                                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                              Margin="0,0,0,4" Cursor="Hand"/>
                                                    <StackPanel Margin="14,0,0,6"
                                                                Visibility="{Binding UsedHappyMedium, Converter={StaticResource BoolToVisConverter}}">
                                                        <controls:WizardItemPickerControl DataContext="{Binding HappyMediumPicker}"
                                                                                          PlaceholderText="Which happy medium?"/>
                                                    </StackPanel>
                                                    <CheckBox Content="Used Astro Paste on this layer"
                                                              IsChecked="{Binding UsedAstroPaste, Mode=TwoWay}"
                                                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                              Margin="0,0,0,4" Cursor="Hand"/>
                                                    <StackPanel Margin="14,0,0,6"
                                                                Visibility="{Binding UsedAstroPaste, Converter={StaticResource BoolToVisConverter}}">
                                                        <controls:WizardItemPickerControl DataContext="{Binding AstroPastePicker}"
                                                                                          PlaceholderText="Which astro paste?"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </StackPanel>
                            </Border>

                            <!-- ── Foil follow-ups: application method (Glitter Grab vs Toner) ─
                                 visible whenever a Foils item is selected. -->
                            <Border Padding="12" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="2" CornerRadius="14"
                                    Visibility="{Binding ShowFoilFollowups, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Foil details" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="How was the foil applied?" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="Glitter Grab" GroupName="FoilMethod"
                                                     IsChecked="{Binding FoilApplicationMethod,
                                                                         Converter={StaticResource StringEqualsConverter},
                                                                         ConverterParameter=GlitterGrab, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                     Margin="0,0,16,0" Cursor="Hand"/>
                                        <RadioButton Content="Toner" GroupName="FoilMethod"
                                                     IsChecked="{Binding FoilApplicationMethod,
                                                                         Converter={StaticResource StringEqualsConverter},
                                                                         ConverterParameter=Toner, Mode=TwoWay}"
                                                     Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                     Cursor="Hand"/>
                                    </StackPanel>

                                    <!-- Glitter Grab: stencil + ink + glitter/HM/AP follow-ups -->
                                    <StackPanel Visibility="{Binding IsFoilGlitterGrabSelected, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Stencil used:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <controls:WizardItemPickerControl DataContext="{Binding FoilStencilPicker}"
                                                                          PlaceholderText="Stencil"
                                                                          Margin="0,0,0,8"/>
                                        <TextBlock Text="Ink colors used:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <controls:InkMultiSelectControl DataContext="{Binding FoilStencilInks}"
                                                                        PlaceholderText="Inks"
                                                                        Margin="0,0,0,8"/>
                                        <CheckBox Content="Used Glitter"
                                                  IsChecked="{Binding FoilStencilUsedGlitter, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                  Margin="0,0,0,4"/>
                                        <!-- Wrapper holds the visibility binding because the inner picker
                                             reassigns DataContext to FoilStencilGlitterPicker, which doesn't
                                             have FoilStencilUsedGlitter. -->
                                        <StackPanel Margin="14,0,0,8"
                                                    Visibility="{Binding FoilStencilUsedGlitter, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Layers (comma-sep, e.g. 1,3):" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                           Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding FoilStencilGlitterLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="100" Padding="6,4"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            </StackPanel>
                                            <controls:WizardItemPickerControl DataContext="{Binding FoilStencilGlitterPicker}"
                                                                              PlaceholderText="Which glitter?"
                                                                              Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <CheckBox Content="Used Happy Medium"
                                                  IsChecked="{Binding FoilStencilUsedHappyMedium, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                  Margin="0,0,0,4"/>
                                        <StackPanel Margin="14,0,0,8"
                                                    Visibility="{Binding FoilStencilUsedHappyMedium, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Layers (comma-sep, e.g. 1,3):" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                           Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding FoilStencilHappyMediumLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="100" Padding="6,4"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            </StackPanel>
                                            <controls:WizardItemPickerControl DataContext="{Binding FoilStencilHappyMediumPicker}"
                                                                              PlaceholderText="Which happy medium?"
                                                                              Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <CheckBox Content="Used Astro Paste"
                                                  IsChecked="{Binding FoilStencilUsedAstroPaste, Mode=TwoWay}"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                  Margin="0,0,0,4"/>
                                        <StackPanel Margin="14,0,0,0"
                                                    Visibility="{Binding FoilStencilUsedAstroPaste, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Layers (comma-sep, e.g. 1,3):" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                           Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding FoilStencilAstroPasteLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="100" Padding="6,4"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            </StackPanel>
                                            <controls:WizardItemPickerControl DataContext="{Binding FoilStencilAstroPastePicker}"
                                                                              PlaceholderText="Which astro paste?"
                                                                              Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Toner: text typed + font (standard dropdown + custom override) -->
                                    <StackPanel Visibility="{Binding IsFoilTonerSelected, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Text typed:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding FoilTonerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4" Margin="0,0,0,8"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                        <TextBlock Text="Font:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding StandardFonts}"
                                                  SelectedItem="{Binding FoilTonerFont, Mode=TwoWay}"
                                                  Padding="6,4" Margin="0,0,0,6"
                                                  Background="{DynamicResource InputBackgroundBrush}"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <!-- Preview rendered in the row's own font. The phrase is a
                                                             card-crafting pangram (every letter A-Z) so every glyph
                                                             in the font is exercised. -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Jazzy crafty stampers quickly emboss vibrant pink dies with hand-glued foil &amp; wax"
                                                                   FontFamily="{Binding}"
                                                                   FontSize="14"
                                                                   Margin="12,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="…or type a custom font name:" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding FoilTonerCustomFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"
                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Live "current selection" preview – auto-updates as the user picks items. -->
                    <Border Grid.Row="4" Padding="12,8" Margin="6,12,6,0"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasCurrentDetailPreview, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Current selection" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentDetailPreview}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Two save actions: one stays so the user can add another detail set,
                         one saves and goes back to the parent (label adapts via DetailsReturnButtonLabel). -->
                    <Grid Grid.Row="5" Margin="6,8,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource HubPrimaryButton}"
                                Content="Save &amp; Add Another"
                                Command="{Binding SaveDetailsAndAddAnotherCommand}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource HubPrimaryButton}"
                                Content="{Binding DetailsReturnButtonLabel}"
                                Command="{Binding SaveDetailsAndReturnCommand}"
                                Margin="6,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- ═══ Adhesives sub-page (3 subtype-filtered pickers + Save) ═══ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCardBaseSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsCardBaseAdhesivesStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- back button -->
                        <RowDefinition Height="Auto"/>  <!-- added-adhesives chip strip -->
                        <RowDefinition Height="Auto"/>  <!-- 3 pickers -->
                        <RowDefinition Height="Auto"/>  <!-- live current-selection preview -->
                        <RowDefinition Height="Auto"/>  <!-- save button -->
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to Cardbase"
                            Command="{Binding BackToCardBaseHubCommand}"/>

                    <!-- Added-adhesives chip strip (auto-hides when nothing's been saved yet) -->
                    <Border Grid.Row="1" Margin="6,0,6,8" Padding="10,8"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CardBaseAdhesivesCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                       Margin="0,0,0,6">
                                <Run Text="Added so far ("/><Run Text="{Binding CardBaseAdhesivesCount, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding CardBaseAddedAdhesives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SidebarBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="10,4" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="320"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <Button Content="✕"
                                                        Style="{StaticResource WizardCloseButton}"
                                                        Command="{Binding DataContext.RemoveCardBaseAdhesiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20"
                                                        Margin="8,0,0,0"
                                                        ToolTip="Remove this adhesive"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding GlueAdhesivePicker}"
                                                          PlaceholderText="Glue"/>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="1"
                                                          DataContext="{Binding FoamAdhesivePicker}"
                                                          PlaceholderText="Foam"/>
                        <!-- Lone in its row → span both columns. -->
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                          DataContext="{Binding TapeRunnerAdhesivePicker}"
                                                          PlaceholderText="Tape Runner"/>
                    </Grid>

                    <!-- Live "current selection" preview -->
                    <Border Grid.Row="3" Padding="12,8" Margin="6,12,6,0"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasCurrentCardBaseAdhesivePick, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Current selection" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentCardBaseAdhesivePreview}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Adhesives"
                            Command="{Binding SaveCardBaseAdhesivesCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Background Mat hub (4 sub-page buttons + 2 actions) ════════
                     Mirrors the Cardbase sub-hub layout. The user enters via the
                     main hub's "Background Mat" button, configures one or more
                     pieces through the sub-pages, then commits via Add Mat. -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBackgroundOrAdditionalMatActive}" Value="True"/>
                                        <Condition Binding="{Binding IsBgMatHubStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- back button -->
                        <RowDefinition Height="Auto"/>  <!-- pieces chip strip -->
                        <RowDefinition Height="Auto"/>  <!-- 4 sub-page buttons -->
                        <RowDefinition Height="Auto"/>  <!-- 2 action buttons -->
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to hub"
                            Command="{Binding BackToHubCommand}"/>

                    <!-- Pieces chip strip — shows committed pieces with X to remove. -->
                    <Border Grid.Row="1" Margin="6,0,6,8" Padding="10,8"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentBgMatPieces.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6">
                                <Run Text="Pieces ("/><Run Text="{Binding CurrentBgMatPieces.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding CurrentBgMatPieces}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SidebarBrush}"
                                                BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="12"
                                                Padding="10,4" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           MaxWidth="320" TextTrimming="CharacterEllipsis">
                                                    <Run Text="Piece "/><Run Text="{Binding Layer, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding DisplaySummary, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Button Content="✕"
                                                        Style="{StaticResource WizardCloseButton}"
                                                        Command="{Binding DataContext.RemoveBgMatPieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="20" Height="20" Margin="8,0,0,0"
                                                        ToolTip="Remove this piece"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="2" Rows="2" Columns="2" VerticalAlignment="Center">
                        <!-- Row 1: Cardstock | Details -->
                        <Button Command="{Binding NavBgMatToCardstockCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Cardstock"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BgPieceCardstockSaved}" Value="True">
                                            <Setter Property="Content" Value="Cardstock - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavBgMatToDetailsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Details"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BgPieceDetailsSaved}" Value="True">
                                            <Setter Property="Content" Value="Details - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Row 2: How was it cut | Adhesives -->
                        <Button Command="{Binding NavBgMatToHowCutCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="How was it cut"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BgPieceHowCutSaved}" Value="True">
                                            <Setter Property="Content" Value="How was it cut - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding NavBgMatToAdhesivesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Setter Property="Content" Value="Adhesives"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BgPieceAdhesivesSaved}" Value="True">
                                            <Setter Property="Content" Value="Adhesives - Done!"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <!-- Action buttons: Add 1 Piece/Part (commit + stay) | Add Mat (finalize).
                         The left button label adapts via MatPieceActionLabel so Focal Mat
                         reads "Add 1 Part" while Background and Additional read "Add 1 Piece of mat". -->
                    <Grid Grid.Row="3" Margin="6,12,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource HubPrimaryButton}"
                                Content="{Binding MatPieceActionLabel}"
                                Command="{Binding AddBgMatPieceCommand}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource HubPrimaryButton}"
                                Content="Add Mat"
                                Command="{Binding AddBgMatCommand}"
                                Margin="6,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- ═══ BG Mat / Cardstock sub-page ════════════════════════════════
                     Three styled-as-button pickers (Cardstock / Foil / Glitter) +
                     self-blend follow-up section + Save. Reuses Cardbase's item
                     buckets (BaseCardstock*Items) — only the picker instances are
                     per-context so selection state stays independent. -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBackgroundOrAdditionalMatActive}" Value="True"/>
                                        <Condition Binding="{Binding IsBgMatCardstockStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="{Binding MatBackButtonLabel}"
                            Command="{Binding BackToBgMatHubCommand}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding BgPieceCardstockPicker}"
                                                          PlaceholderText="Cardstock"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0"
                                                          DataContext="{Binding BgPieceFoilCardstockPicker}"
                                                          PlaceholderText="Foil Cardstock"/>
                        <controls:WizardItemPickerControl Grid.Row="2" Grid.Column="0"
                                                          DataContext="{Binding BgPieceGlitterCardstockPicker}"
                                                          PlaceholderText="Glitter Cardstock"/>
                    </Grid>

                    <!-- Self-blend follow-up — collapsed by default, expands when checked.
                         Alternative considered: separate sub-page button. Rejected — too
                         coarse for an optional inline detail. -->
                    <Border Grid.Row="2" Padding="12" Margin="6,12,6,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <StackPanel>
                            <CheckBox Content="Self-blended cardstock"
                                      IsChecked="{Binding CurrentMat.IsSelfBlended, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,0,6" Cursor="Hand"/>
                            <StackPanel Visibility="{Binding CurrentMat.IsSelfBlended, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Description (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding CurrentMat.SelfBlendDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,0,8"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <!-- Inks blended into the cardstock — multi-select dropdown, click order preserved. -->
                                <TextBlock Text="Inks used (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <controls:InkMultiSelectControl DataContext="{Binding BgPieceBlendInks}"
                                                                PlaceholderText="Pick blend inks..."
                                                                Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Confirm Cardstock"
                            Command="{Binding SaveBgPieceCardstockCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ BG Mat / How was it cut sub-page ═══════════════════════════
                     Per the user's mockup: 4×2 method buttons (Stacklets, All Planned
                     Out, Frames, Insider, Foil-It, Custom Size, None — one slot empty)
                     with the chosen method highlighted, then a wide Confirm Cut. The
                     actual item the cut applies to is captured via the Details
                     sub-page, not here. -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBackgroundOrAdditionalMatActive}" Value="True"/>
                                        <Condition Binding="{Binding IsBgMatHowCutStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- back button -->
                        <RowDefinition Height="Auto"/>  <!-- 7 method buttons UniformGrid -->
                        <RowDefinition Height="Auto"/>  <!-- per-method follow-ups -->
                        <RowDefinition Height="Auto"/>  <!-- Confirm Cut -->
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="{Binding MatBackButtonLabel}"
                            Command="{Binding BackToBgMatHubCommand}"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- 5 method dropdowns + 2 plain buttons (Custom Size, None).
                             Each picker, on selection, sets CurrentMat.CuttingMethod via the
                             echo wiring in WireBgCutPickerEcho — and clears the other 4.
                             Custom Size and None route through the legacy
                             SelectBgCuttingMethodCommand which also clears every dropdown. -->
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding BgCutStackletsPicker}"
                                                          PlaceholderText="Stacklets"/>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="1"
                                                          DataContext="{Binding BgCutPlannedOutPicker}"
                                                          PlaceholderText="All Planned Out"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0"
                                                          DataContext="{Binding BgCutFramesPicker}"
                                                          PlaceholderText="Frames"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="1"
                                                          DataContext="{Binding BgCutInsiderPicker}"
                                                          PlaceholderText="Insider"/>
                        <controls:WizardItemPickerControl Grid.Row="2" Grid.Column="0"
                                                          DataContext="{Binding BgCutFoilItPicker}"
                                                          PlaceholderText="Foil-It"/>
                        <!-- "Custom Size" displays per the mockup; canonical method string
                             is "Custom" so existing data-model checks keep working. -->
                        <Button Grid.Row="2" Grid.Column="1"
                                Content="Custom Size" Command="{Binding SelectBgCuttingMethodCommand}" CommandParameter="Custom">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding CurrentBgCuttingMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Custom}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- Lone in its row → span both columns. -->
                        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                Content="None" Command="{Binding SelectBgCuttingMethodCommand}" CommandParameter="None">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding CurrentBgCuttingMethod, Converter={StaticResource StringEqualsConverter}, ConverterParameter=None}">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Per-method follow-ups: appear once a method is picked.
                         Stacklets / Frames → "Which die in the set?" + "How many layers?"
                         All Planned Out    → "How many layers?" only -->
                    <Border Grid.Row="2" Padding="12" Margin="6,12,6,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="2" CornerRadius="14"
                            Visibility="{Binding ShowAnyCutFollowups, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Cut details" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                            <!-- Header echoing the active method + picked item so the user
                                 can verify before answering "which die / how many layers". -->
                            <TextBlock Text="{Binding CutFollowupHeader}"
                                       FontStyle="Italic" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowCutDieIndex, Converter={StaticResource BoolToVisConverter}}"
                                        Margin="0,0,0,6">
                                <TextBlock Text="Which die in the set? (1 = largest)" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,8,0"/>
                                <TextBox Text="{Binding CurrentMat.CutDieIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" Padding="6,4"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowCutLayers, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="How many layers cut?" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,8,0"/>
                                <TextBox Text="{Binding CurrentMat.CutLayers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" Padding="6,4"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Foil sheet picker — shown when method is Foil-It or Insider.
                                 Drawn from type="Foils". Independent of the cut tool: the
                                 user can also pick a die from the Stacklets / Frames /
                                 All Planned Out dropdown above to express a die-cut Insider. -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowCutFoils, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Foil sheet used:"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <controls:WizardItemPickerControl DataContext="{Binding BgCutFoilsPicker}"
                                                                  PlaceholderText="Foil sheet"
                                                                  Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Confirm Cut"
                            Command="{Binding SaveBgPieceHowCutCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ BG Mat / Adhesives sub-page ════════════════════════════════
                     Mirrors Cardbase Adhesives but routes saves to CurrentMat.Adhesives. -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBackgroundOrAdditionalMatActive}" Value="True"/>
                                        <Condition Binding="{Binding IsBgMatAdhesivesStep}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="{Binding MatBackButtonLabel}"
                            Command="{Binding BackToBgMatHubCommand}"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding BgPieceGlueAdhesivePicker}"
                                                          PlaceholderText="Glue"/>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="1"
                                                          DataContext="{Binding BgPieceFoamAdhesivePicker}"
                                                          PlaceholderText="Foam"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                          DataContext="{Binding BgPieceTapeRunnerAdhesivePicker}"
                                                          PlaceholderText="Tape Runner"/>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,8" Margin="6,12,6,0"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasCurrentBgPieceAdhesivePick, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Current selection" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentBgPieceAdhesivePreview}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Adhesives"
                            Command="{Binding SaveBgPieceAdhesivesCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Sentiment hub (Phase 2 of remaster) ═════════════════════════
                     Two render states based on IsConfiguringCurrentSentiment:
                       1. Search state: textbox + filter checkboxes + Search + results.
                       2. Configuring state: collapsed result + 3 sub-page buttons
                          (Cardstock | Details | Adhesives) + inline ink section
                          + Finish Sentiment / Add 1 Piece to sentiment.
                     Cardstock/Adhesives drill into their own sub-pages below;
                     Details routes through the shared Details panel via
                     DetailsReturnTarget = "Sentiment". -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSentimentSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsSentimentSubStepHub}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- back button -->
                        <RowDefinition Height="Auto"/>  <!-- search box + checkboxes + Search -->
                        <RowDefinition Height="*"/>     <!-- results / configuring panel -->
                        <RowDefinition Height="Auto"/>  <!-- ink section -->
                        <RowDefinition Height="Auto"/>  <!-- footer actions -->
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to hub"
                            Command="{Binding BackToHubCommand}"/>

                    <!-- Search bar — hidden once a sentiment is being configured. -->
                    <StackPanel Grid.Row="1" Margin="6,0,6,8"
                                Visibility="{Binding IsConfiguringCurrentSentiment, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBox Text="{Binding SentimentSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SentimentSearch_KeyDown"
                                 Padding="10,8" FontSize="13" Margin="0,0,0,8"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Foreground="{DynamicResource TextBrush}"/>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox Content="Die only" IsChecked="{Binding SentimentFilterDies}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,16,4" Cursor="Hand"/>
                            <CheckBox Content="Stamp only" IsChecked="{Binding SentimentFilterStamps}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,16,4" Cursor="Hand"/>
                            <CheckBox Content="Full sets" IsChecked="{Binding SentimentFilterFullSets}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,16,4" Cursor="Hand"/>
                            <CheckBox Content="Theme search" IsChecked="{Binding SentimentFilterThemeSearch}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,16,4" Cursor="Hand"
                                      ToolTip="Treat the typed query as a theme name (matches item subtype)"/>
                        </WrapPanel>
                        <Button Style="{StaticResource HubPrimaryButton}"
                                Content="Search"
                                Command="{Binding SearchSentimentsCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Results / Configuring panel — main middle box per the mockup. -->
                    <Border Grid.Row="2" Margin="6,0,6,8" Padding="10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <Grid>
                            <!-- Search-state results list: visible until a sentiment is picked. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"
                                          Visibility="{Binding IsConfiguringCurrentSentiment, Converter={StaticResource InverseBoolToVisConverter}}">
                                <ItemsControl ItemsSource="{Binding SentimentResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSentimentResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,2" Padding="8"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="72" Height="72"
                                                            Background="{DynamicResource SidebarBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="4">
                                                        <Image Source="{Binding ThumbnailBase64, Converter={StaticResource Base64ImageConverter}}"
                                                               Stretch="Uniform"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding ItemName}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SentimentPreview}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   MaxHeight="48" TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Configuring state: collapsed selected sentiment + 3 sub-page buttons. -->
                            <StackPanel Visibility="{Binding IsConfiguringCurrentSentiment, Converter={StaticResource BoolToVisConverter}}">
                                <Border Background="{DynamicResource SidebarBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="72" Height="72"
                                                Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4">
                                            <Image Source="{Binding CurrentSentimentResult.ThumbnailBase64, Converter={StaticResource Base64ImageConverter}}"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding CurrentSentimentResult.ItemName}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentSentimentResult.SentimentPreview}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Change selection: clears CurrentSentimentResult, restores the search list. -->
                                        <Button Grid.Column="2" Content="Change"
                                                Command="{Binding CancelSentimentConfigCommand}"
                                                Padding="8,4" Margin="8,0,0,0" FontSize="11"
                                                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" Foreground="{DynamicResource TextMutedBrush}"
                                                Cursor="Hand" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 3 sub-page buttons: Cardstock | Details | Adhesives -->
                                <UniformGrid Rows="1" Columns="3">
                                    <Button Command="{Binding NavSentimentToCardstockCommand}" Margin="0,0,4,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                                <Setter Property="Content" Value="Cardstock"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SentimentPieceCardstockSaved}" Value="True">
                                                        <Setter Property="Content" Value="Cardstock - Done!"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding NavSentimentToDetailsCommand}" Margin="2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                                <Setter Property="Content" Value="Details"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SentimentPieceDetailsSaved}" Value="True">
                                                        <Setter Property="Content" Value="Details - Done!"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding NavSentimentToAdhesivesCommand}" Margin="4,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HubButton}">
                                                <Setter Property="Content" Value="Adhesives"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SentimentPieceAdhesivesSaved}" Value="True">
                                                        <Setter Property="Content" Value="Adhesives - Done!"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inline ink section: matches the Details tab stamp-ink pattern.
                         Visible only while configuring a selected sentiment. -->
                    <Border Grid.Row="3" Margin="6,0,6,8" Padding="12"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="14"
                            Visibility="{Binding IsConfiguringCurrentSentiment, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Ink colors used:"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <controls:InkMultiSelectControl DataContext="{Binding SentimentInks}"
                                                            PlaceholderText="Pick inks..."
                                                            ShowEmbossedChip="True"
                                                            Margin="0,0,0,8"/>
                            <StackPanel Visibility="{Binding SentimentInks.IsEmbossed, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Embossing powder:"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <controls:WizardItemPickerControl DataContext="{Binding SentimentStampEmbossingPowderPicker}"
                                                                  PlaceholderText="Embossing Powder"
                                                                  Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer: Finish Sentiment / Add 1 Piece to sentiment.
                         Visible only while configuring a selected sentiment. -->
                    <Grid Grid.Row="4" Margin="6,0,6,4"
                          Visibility="{Binding IsConfiguringCurrentSentiment, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource HubPrimaryButton}"
                                Content="Finish Sentiment"
                                Command="{Binding FinishSentimentCommand}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Column="1" Style="{StaticResource HubPrimaryButton}"
                                Content="Add 1 Piece to sentiment"
                                Command="{Binding AddSentimentPieceCommand}"
                                Margin="6,0,0,0"/>
                    </Grid>
                </Grid>

                <!-- ═══ Sentiment / Cardstock sub-page (mirrors BG mat Cardstock) ═══ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSentimentSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsSentimentSubStepCardstock}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to Sentiment"
                            Command="{Binding BackToSentimentHubCommand}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding SentimentCardstockPicker}"
                                                          PlaceholderText="Cardstock"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0"
                                                          DataContext="{Binding SentimentFoilCardstockPicker}"
                                                          PlaceholderText="Foil Cardstock"/>
                        <controls:WizardItemPickerControl Grid.Row="2" Grid.Column="0"
                                                          DataContext="{Binding SentimentGlitterCardstockPicker}"
                                                          PlaceholderText="Glitter Cardstock"/>
                    </Grid>

                    <Border Grid.Row="2" Padding="12" Margin="6,12,6,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2" CornerRadius="14">
                        <StackPanel>
                            <CheckBox Content="Self-blended cardstock"
                                      IsChecked="{Binding SentimentIsSelfBlended, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextBrush}" FontSize="12"
                                      Margin="0,0,0,6" Cursor="Hand"/>
                            <StackPanel Visibility="{Binding SentimentIsSelfBlended, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Description (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SentimentSelfBlendDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,0,8"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <!-- Inks blended into the cardstock — multi-select, click order preserved.
                                     Synced into the captured WizardConfiguredSentimentPart.BlendInkColors. -->
                                <TextBlock Text="Inks used (optional):"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           Margin="0,0,0,4"/>
                                <controls:InkMultiSelectControl DataContext="{Binding SentimentBlendInks}"
                                                                PlaceholderText="Pick blend inks..."
                                                                Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Confirm Cardstock"
                            Command="{Binding SaveSentimentCardstockCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Sentiment / Adhesives sub-page (mirrors BG mat Adhesives) ═══ -->
                <Grid Margin="0,0,0,8">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSentimentSectionActive}" Value="True"/>
                                        <Condition Binding="{Binding IsSentimentSubStepAdhesives}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Style="{StaticResource BackButton}" Content="← Back to Sentiment"
                            Command="{Binding BackToSentimentHubCommand}"/>

                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="0"
                                                          DataContext="{Binding SentimentGlueAdhesivePicker}"
                                                          PlaceholderText="Glue"/>
                        <controls:WizardItemPickerControl Grid.Row="0" Grid.Column="1"
                                                          DataContext="{Binding SentimentFoamAdhesivePicker}"
                                                          PlaceholderText="Foam"/>
                        <controls:WizardItemPickerControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                          DataContext="{Binding SentimentTapeRunnerAdhesivePicker}"
                                                          PlaceholderText="Tape Runner"/>
                    </Grid>

                    <Border Grid.Row="2" Padding="12,8" Margin="6,12,6,0"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding HasCurrentSentimentAdhesivePick, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="Current selection" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentSentimentAdhesivePreview}"
                                       Foreground="{DynamicResource TextBrush}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource HubPrimaryButton}"
                            Content="Save Adhesives"
                            Command="{Binding SaveSentimentAdhesivesCommand}"
                            Margin="6,12,6,4"/>
                </Grid>

                <!-- ═══ Section 4: Embellishments (rebuilt to match Details tab UX) ═══
                     Reuses the Details tab's EmbellishmentsPicker + EmbellEmbossingInks +
                     EmbellEmbossingStampPicker so the data sources and embossing-powder
                     follow-up behave identically. Save & Add Another / Save & Return
                     pattern captures into AddedEmbellishments (the general-card list). -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding IsEmbellishmentsSectionActive, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <Button Style="{StaticResource BackButton}" Content="← Back to hub"
                                Command="{Binding BackToHubCommand}"/>
                        <TextBlock Text="Embellishments" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                        <!-- Already-added list with ✕ to remove an accidental add. -->
                        <ItemsControl ItemsSource="{Binding AddedEmbellishments}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SidebarBrush}" CornerRadius="6"
                                            Padding="10,7" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplaySummary}"
                                                       Foreground="{DynamicResource TextBrush}" FontSize="12"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="✕" VerticalAlignment="Top"
                                                    Style="{StaticResource WizardCloseButton}"
                                                    Command="{Binding DataContext.RemoveEmbellishmentCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Width="22" Height="22" FontSize="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Item picker — same control + same DataContext as the Details tab. -->
                        <controls:WizardItemPickerControl DataContext="{Binding EmbellishmentsPicker}"
                                                          PlaceholderText="Embellishments"
                                                          Margin="0,0,0,8"/>

                        <!-- Embossing-powder follow-up — appears only when the picked
                             embellishment has "Embossing Powder" in its subtype. Same
                             ink-multiselect + stamp picker as the Details tab. -->
                        <Border Padding="12" Margin="0,0,0,12"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="2" CornerRadius="14"
                                Visibility="{Binding ShowEmbellEmbossingFollowups, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="Embossing powder details" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Ink colors used:" Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <controls:InkMultiSelectControl DataContext="{Binding EmbellEmbossingInks}"
                                                                PlaceholderText="Inks"
                                                                Margin="0,0,0,8"/>
                                <TextBlock Text="Stamp embossed:"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <controls:WizardItemPickerControl DataContext="{Binding EmbellEmbossingStampPicker}"
                                                                  PlaceholderText="Stamp embossed with this powder"
                                                                  Margin="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Live preview of the in-progress pick (auto-hides when nothing's picked). -->
                        <Border Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding HasHubEmbellishmentPick, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="Current selection" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding CurrentHubEmbellishmentPreview}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Two save actions: Add Another stays on this page; Return goes back to the hub. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource HubPrimaryButton}"
                                    Content="Save &amp; Add Another"
                                    Command="{Binding SaveHubEmbellishmentAndAddAnotherCommand}"
                                    Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Style="{StaticResource HubPrimaryButton}"
                                    Content="Save &amp; Return to Hub"
                                    Command="{Binding SaveHubEmbellishmentAndReturnCommand}"
                                    Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>


                </StackPanel>
                </ScrollViewer>
            </Grid>
            </ScrollViewer>

            <!-- ═══ Right: Running summary ══════════════════════════════════════ -->
            <Border Grid.Column="2" Style="{StaticResource HubSidePanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Summary" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" Margin="4,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="No items selected yet."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontStyle="Italic" FontSize="12" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SummaryLines.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SummaryLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Text}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"/>
                                            <!-- Remove button — only visible for rows with a RemoveAction.
                                                 Wired via RemoveSummaryRowCommand on the parent VM. -->
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Style="{StaticResource WizardCloseButton}"
                                                    ToolTip="Remove this entry"
                                                    Command="{Binding DataContext.RemoveSummaryRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisConverter}}"
                                                    Width="20" Height="20"
                                                    Margin="6,0,0,0"
                                                    Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
