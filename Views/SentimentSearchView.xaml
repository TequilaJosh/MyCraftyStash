<UserControl x:Class="MyCraftyStash.Views.SentimentSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyCraftyStash.ViewModels"
             Background="{DynamicResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="32,22,32,14">
            <StackPanel>
                <StackPanel Visibility="{Binding IsViewingItem, Converter={StaticResource InverseBoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="My Crafty Stash"/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="  /  "/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="Sentiment search"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Sentiment search" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Find the perfect stamp set by sentiment phrase."/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsViewingItem, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="Sentiment search"/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="  /  "/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="{Binding CurrentItem.Name}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding CurrentItem.Name}" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding CurrentItem.Type}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search bar row (hidden when viewing item detail) -->
        <Border Grid.Row="1"
                Background="Transparent"
                Padding="32,4,32,16">
            <Grid>
                <!-- Search bar (list state) -->
                <Grid Visibility="{Binding IsViewingItem, Converter={StaticResource InverseBoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,6" FontSize="14"
                             KeyDown="SearchBox_KeyDown"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButton}"
                            Content="Search"
                            Command="{Binding SearchCommand}"
                            VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding FindUnsnippedSetsCommand}"
                            Content="Search for unsnipped sentiments"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"/>
                    <Border Grid.Column="3"
                            Background="{DynamicResource BorderBrush}"
                            CornerRadius="4" Padding="8,4" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                            <Run Text="{Binding Sentiments.Count, Mode=OneWay}"/>
                            <Run Text=" results"/>
                        </TextBlock>
                    </Border>
                    <CheckBox Grid.Column="4" Content="Show full sets" IsChecked="{Binding ExpandBySet}"
                              Foreground="{DynamicResource TextBrush}" FontSize="12"
                              Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>
                <!-- Back / View in Inventory (detail state) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsViewingItem, Converter={StaticResource BoolToVisConverter}}">
                    <Button Style="{StaticResource SecondaryButton}"
                            Content="← Back"
                            Command="{Binding GoBackCommand}"
                            Padding="20,9"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="View in Inventory"
                            Command="{Binding NavigateToItemInInventoryCommand}"
                            Margin="12,0,0,0"
                            Padding="20,9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            
            <!-- Search Results View -->
            <Grid Visibility="{Binding IsViewingItem, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                
                <!-- Extraction Mode Panel -->
                <Border Background="{DynamicResource CardBrush}" 
                        CornerRadius="8" 
                        Padding="24" 
                        Margin="24"
                        Visibility="{Binding IsExtractingMode, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <!-- Item Selection (when not in manual mode) -->
                        <StackPanel Visibility="{Binding IsManualSelectionMode, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="Extract Sentiments from Item"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,16"/>
                            
                            <TextBlock Text="Select a stamp with sentiments:" 
                                       Foreground="{DynamicResource TextMutedBrush}" 
                                       Margin="0,0,0,8"/>
                            
                            <ComboBox ItemsSource="{Binding ItemsWithSentiments}" 
                                      SelectedItem="{Binding SelectedExtractItem}"
                                      DisplayMemberPath="Name"
                                      Background="{DynamicResource SidebarBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      Margin="0,0,0,16"
                                      Padding="8"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Style="{StaticResource PrimaryButton}" 
                                        Content="Open Crop Tool" 
                                        Command="{Binding StartManualSelectionCommand}"
                                        IsEnabled="{Binding SelectedExtractItem, Converter={StaticResource NullToBoolConverter}}"
                                        Margin="0,0,12,0"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Cancel"
                                        Command="{Binding CancelExtractModeCommand}"/>
                            </StackPanel>
                            
                            <TextBlock Text="{Binding ExtractionStatus}" 
                                       Foreground="{DynamicResource PrimaryBrush}" 
                                       FontWeight="SemiBold"
                                       Visibility="{Binding ExtractionStatus, Converter={StaticResource NullToVisConverter}}"/>
                        </StackPanel>
                        
                        <!-- Manual Selection Mode -->
                        <Grid Visibility="{Binding IsManualSelectionMode, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Header -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Manual Extraction: "/>
                                    <Run Text="{Binding SelectedExtractItem.Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ExtractionStatus}" 
                                           Foreground="{DynamicResource PrimaryBrush}" 
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <!-- Image Selection and Canvas -->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Image Selector -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Select Image:" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ExtractItemImages}"
                                              SelectedItem="{Binding SelectedExtractImage}"
                                              Background="{DynamicResource SidebarBrush}"
                                              Foreground="{DynamicResource TextBrush}"
                                              Padding="8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Id, StringFormat='Image #{0}'}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                
                                <!-- Image Canvas with Selection Rectangle -->
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource SidebarBrush}" 
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <Viewbox Stretch="Uniform">
                                        <Canvas x:Name="SelectionCanvas"
                                                Background="Transparent"
                                                ClipToBounds="True"
                                                Width="800" Height="600"
                                                MouseLeftButtonDown="SelectionCanvas_MouseDown"
                                                MouseMove="SelectionCanvas_MouseMove"
                                                MouseLeftButtonUp="SelectionCanvas_MouseUp">
                                            <Image x:Name="ExtractImage"
                                                   Source="{Binding SelectedExtractImage.ImageUrl, Converter={StaticResource Base64ImageConverter}, NotifyOnTargetUpdated=True}"
                                                   Stretch="None"
                                                   TargetUpdated="ExtractImage_TargetUpdated"
                                                   Canvas.Left="0"
                                                   Canvas.Top="0"/>
                                            <Rectangle x:Name="SelectionRect"
                                                       Stroke="{DynamicResource PrimaryBrush}"
                                                       StrokeThickness="2"
                                                       StrokeDashArray="4 2"
                                                       Fill="{DynamicResource SentimentSelectionBrush}"
                                                       Canvas.Left="{Binding SelectionX}"
                                                       Canvas.Top="{Binding SelectionY}"
                                                       Width="{Binding SelectionWidth}"
                                                       Height="{Binding SelectionHeight}"
                                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisConverter}}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>
                            
                            <!-- Sentiment List -->
                            <Border Grid.Row="1" Grid.Column="1" 
                                    Background="{DynamicResource SidebarBrush}" 
                                    CornerRadius="4" 
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="Sentiments to Extract:" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,8"/>
                                    
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SentimentsToExtract}"
                                             SelectedItem="{Binding SelectedSentimentToExtract}"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="●"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               FontWeight="Bold"
                                                               Margin="0,0,8,0"
                                                               Visibility="{Binding IsExtracted, Converter={StaticResource BoolToVisConverter}}"/>
                                                    <TextBlock Text="○" 
                                                               Foreground="{DynamicResource TextMutedBrush}" 
                                                               Margin="0,0,8,0"
                                                               Visibility="{Binding IsExtracted, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                                                    <TextBlock Text="{Binding Text}" 
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            
                            <!-- Buttons -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" 
                                        Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" 
                                        Content="Snip Sentiment" 
                                        Command="{Binding SnipSentimentCommand}"
                                        IsEnabled="{Binding HasSelection}"
                                        Margin="0,0,12,0"/>
                                <Button Style="{StaticResource SecondaryButton}" 
                                        Content="Clear Selection" 
                                        Click="ClearSelection_Click"
                                        Margin="0,0,12,0"/>
                                <Button Style="{StaticResource SecondaryButton}" 
                                        Content="Done" 
                                        Command="{Binding CancelManualSelectionCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Search Results Grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="24"
                              Visibility="{Binding IsExtractingMode, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                    <Grid>
                        <!-- Unsnipped sets list -->
                        <Grid Visibility="{Binding IsViewingUnsnipped, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding UnsnippedSets.Count, Converter={StaticResource ZeroToVisConverter}}">
                                <TextBlock Text="No unsnipped sets"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Every set with listed sentiments has been fully snipped."
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding UnsnippedSets}"
                                          Visibility="{Binding UnsnippedSets.Count, Converter={StaticResource ZeroToVisConverter}, ConverterParameter=Inverse}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220"
                                                Margin="0,0,16,16"
                                                CornerRadius="8"
                                                Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.NavigateToItemFromUnsnippedCommand,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <Grid>
                                                    <Border Height="140"
                                                            CornerRadius="8,8,0,0"
                                                            Background="{DynamicResource SidebarBrush}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ImageConverter}, TargetNullValue={x:Null}}"
                                                               Stretch="Uniform"
                                                               Margin="8"/>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,8,8,0" CornerRadius="4" Padding="6,2"
                                                            Background="{DynamicResource PrimaryBrush}">
                                                        <TextBlock FontSize="11" FontWeight="Bold"
                                                                   Foreground="White">
                                                            <Run Text="{Binding MissingCount, Mode=OneWay}"/>
                                                            <Run Text=" missing"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Margin="12,10,12,12">
                                                    <TextBlock Text="{Binding ItemName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ItemType}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Empty State (hidden in unsnipped mode) -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Sentiments.Count, Converter={StaticResource ZeroToVisConverter}}">
                            <StackPanel Visibility="{Binding IsViewingUnsnipped, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="Search for sentiments"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Enter a word or phrase to find matching sentiment stamps"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Results -->
                        <ItemsControl ItemsSource="{Binding Sentiments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding CardWidth}" 
                                            Margin="0,0,16,16" 
                                            CornerRadius="8"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="SentimentCard_Click"
                                            Tag="{Binding}">
                                        <StackPanel>
                                            <!-- Image area with size badge overlay -->
                                            <Grid>
                                                <Border Height="{Binding ImageHeight}" 
                                                        CornerRadius="8,8,0,0"
                                                        Background="{DynamicResource SidebarBrush}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ImageData, Converter={StaticResource Base64ImageConverter}}" 
                                                           Stretch="Uniform" 
                                                           Margin="8"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Size badge: XS/S/M/L/XL top-right corner -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,6,6,0" CornerRadius="3" Padding="5,2"
                                                        Background="{DynamicResource SentimentTooltipBrush}">
                                                    <TextBlock Text="{Binding SizeLabel}"
                                                               FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding SizeLabelColor}"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="10,8">
                                                <TextBlock Text="{Binding ExtractedText}" 
                                                           FontSize="12" 
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="36"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ItemName}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
            
            <!-- Item Detail View -->
            <Grid Visibility="{Binding IsViewingItem, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                
                <!-- Main Item Content -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel>
                        <!-- Main Image -->
                        <Border Background="{DynamicResource SidebarBrush}" 
                                CornerRadius="8" 
                                Padding="16" 
                                MaxHeight="400"
                                Margin="0,0,0,24"
                                Visibility="{Binding CurrentItem.ImageUrl, Converter={StaticResource NullToVisConverter}}">
                            <Image Source="{Binding CurrentItem.ImageUrl, Converter={StaticResource Base64ImageConverter}}" 
                                   Stretch="Uniform"
                                   MaxHeight="360"/>
                        </Border>
                        
                        <!-- Item Details -->
                        <Border Background="{DynamicResource CardBrush}" 
                                CornerRadius="8" 
                                Padding="20"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Type" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.Type}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Item Number" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.ItemNumber, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="Theme" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.Theme, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Location" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.Location, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <TextBlock Text="Sentiments" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.Sentiments, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="3" Grid.Column="0">
                                    <TextBlock Text="Price" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.Price, StringFormat=C, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="3" Grid.Column="1">
                                    <TextBlock Text="Date Purchased" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CurrentItem.DatePurchased, StringFormat=d, TargetNullValue='N/A'}" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Sentiment Images from this Item -->
                        <TextBlock Text="Sentiments from this Set" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding CurrentItemSentiments.Count, Converter={StaticResource ZeroToVisConverter}, ConverterParameter=Inverse}"/>
                        
                        <ItemsControl ItemsSource="{Binding CurrentItemSentiments}"
                                      Visibility="{Binding CurrentItemSentiments.Count, Converter={StaticResource ZeroToVisConverter}, ConverterParameter=Inverse}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="140" 
                                            Height="100"
                                            Margin="0,0,12,12" 
                                            CornerRadius="8"
                                            Background="{DynamicResource SidebarBrush}"
                                            ToolTip="{Binding ExtractedText}">
                                        <Grid>
                                            <Image Source="{Binding ImageData, Converter={StaticResource Base64ImageConverter}}" 
                                                   Stretch="Uniform" 
                                                   Margin="8"
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="X"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4"
                                                    Command="{Binding DataContext.DeleteSentimentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                
                <!-- Right Sidebar - Related Items & Gallery -->
                <Border Grid.Column="1" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            
                            <!-- Related Items -->
                            <TextBlock Text="Related Items" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,12"/>
                            
                            <ItemsControl ItemsSource="{Binding CurrentItemRelated}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SidebarBrush}" 
                                                CornerRadius="8" 
                                                Padding="12" 
                                                Margin="0,0,0,8"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="RelatedItem_Click"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4" Background="{DynamicResource CardBrush}">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ImageConverter}}" 
                                                           Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="13" 
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Type}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <TextBlock Text="No related items" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding CurrentItemRelated.Count, Converter={StaticResource ZeroToVisConverter}}"
                                       Margin="0,0,0,24"/>
                            
                            <!-- Additional Gallery Images -->
                            <TextBlock Text="Gallery" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,24,0,12"
                                       Visibility="{Binding CurrentItemImages.Count, Converter={StaticResource ZeroToVisConverter}, ConverterParameter=Inverse}"/>
                            
                            <ItemsControl ItemsSource="{Binding CurrentItemImages}"
                                          Visibility="{Binding CurrentItemImages.Count, Converter={StaticResource ZeroToVisConverter}, ConverterParameter=Inverse}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" 
                                                Height="80" 
                                                Margin="0,0,8,8" 
                                                CornerRadius="8"
                                                Background="{DynamicResource SidebarBrush}">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ImageConverter}}" 
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            
            <!-- Loading Overlay -->
            <Border Background="{DynamicResource OverlayDimBrush}" 
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading..." 
                               FontSize="18" 
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
