<UserControl x:Class="MyCraftyStash.Views.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- tab strip -->
            <RowDefinition Height="Auto"/>  <!-- list header card -->
            <RowDefinition Height="*"/>     <!-- table -->
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Padding="32,22,32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="My Crafty Stash"/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="  /  "/>
                        <TextBlock Style="{StaticResource Breadcrumb}" Text="Wish List"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Wish List" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Stamps, dies, and supplies you're hoping to add"/>
                </StackPanel>
                <Grid Grid.Column="1" Width="320" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchTextBox}" Padding="38,10,12,10" FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍" FontSize="13" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="Search wish list…" FontSize="13" Margin="38,0,12,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Tab strip + import actions, stacked in two rows so the action
             buttons can never collide with the list tabs:
               row 0 — list-management + import buttons (left + right groups);
               row 1 — chevron-flanked horizontally-scrolling tab strip.
             The scrollbar stays hidden; the ‹ / › chevrons drive scrolling
             when the user has more lists than fit on one row. -->
        <Border Grid.Row="1" Padding="32,0,32,0" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: action buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ New list" Style="{StaticResource SecondaryButton}"
                                Padding="12,8" Margin="0,4,6,4" FontSize="13"
                                Command="{Binding NewListCommand}"/>
                        <Button Content="+ Add item" Style="{StaticResource SecondaryButton}"
                                Padding="12,8" Margin="0,4,6,4" FontSize="13"
                                Command="{Binding AddItemCommand}"
                                IsEnabled="{Binding HasActiveTab}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✦ Add item from link" Style="{StaticResource SecondaryButton}"
                                Padding="12,8" Margin="0,4,8,4" FontSize="13"
                                Command="{Binding ImportFromLinkCommand}"/>
                        <Button Content="📥 Import TE wishlist" Style="{StaticResource SecondaryButton}"
                                Padding="12,8" Margin="0,4,0,4" FontSize="13"
                                Command="{Binding ImportFromTeWishlistCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: chevron + tab strip + chevron -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="‹"
                            x:Name="TabScrollLeftButton"
                            Click="TabScrollLeft_Click"
                            Width="28" Height="28" Padding="0"
                            Margin="0,0,4,0" VerticalAlignment="Center"
                            FontSize="18" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Cursor="Hand" ToolTip="Scroll tabs left"/>

                    <ScrollViewer Grid.Column="1"
                                  x:Name="TabScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  ScrollChanged="TabScrollViewer_ScrollChanged">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,10" Margin="0,0,2,0" Cursor="Hand" CornerRadius="6,6,0,0"
                                            Background="Transparent">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                                    Margin="0,0,8,0"
                                                    Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <Border CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource BadgeBrush}">
                                                <TextBlock Text="{Binding ItemCount}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="›"
                            x:Name="TabScrollRightButton"
                            Click="TabScrollRight_Click"
                            Width="28" Height="28" Padding="0"
                            Margin="4,0,0,0" VerticalAlignment="Center"
                            FontSize="18" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Cursor="Hand" ToolTip="Scroll tabs right"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Active list header card -->
        <Border Grid.Row="2" Padding="32,18,32,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasActiveTab, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel DataContext="{Binding ActiveTab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{Binding Color, Converter={StaticResource HexToBrushConverter}}"/>
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" items · $"/><Run Text="{Binding EstimatedTotal, StringFormat={}{0:0.00}, Mode=OneWay}"/><Run Text=" estimated"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Edit list" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                Margin="0,0,8,0" FontSize="12"
                                Command="{Binding DataContext.EditActiveListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="✕ Delete list" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"
                                Command="{Binding DataContext.DeleteActiveListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Description}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="24,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Description, Converter={StaticResource NullToVisConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Table area -->
        <Grid Grid.Row="3">
            <!-- Empty state when no lists exist -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasNoTabs, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="&#x2B50;" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Your Wish List" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Create your first list to start tracking items."
                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <Button Content="+ New list" Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewListCommand}" Padding="22,10" Margin="0,18,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Empty list state when an active tab has no items -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasActiveTab}" Value="True"/>
                                    <Condition Binding="{Binding Items.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Nothing on this list yet." FontSize="14"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <Button Content="+ Add item" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddItemCommand}" Padding="18,8" Margin="0,12,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Table -->
            <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding FilteredItems}"
                      AutoGenerateColumns="False" HeadersVisibility="Column"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent" AlternatingRowBackground="Transparent"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderSoftBrush}"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      RowHeight="60" ColumnHeaderHeight="38"
                      Margin="32,8,32,16"
                      Visibility="{Binding HasActiveTab, Converter={StaticResource BoolToVisConverter}}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="14,9"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- ITEM (name + domain) -->
                    <DataGridTemplateColumn Header="ITEM" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url, Converter={StaticResource UrlToDomainConverter}}"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STORE -->
                    <DataGridTextColumn Header="STORE" Width="180" Binding="{Binding PurchasedFrom}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- EST. PRICE -->
                    <DataGridTemplateColumn Header="EST. PRICE" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat=${0:F2}, TargetNullValue=—}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- PRIORITY -->
                    <DataGridTemplateColumn Header="PRIORITY" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="3">
                                                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="2">
                                                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding PriorityLabel}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="3">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="2">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NOTE -->
                    <DataGridTemplateColumn Header="NOTE" Width="*" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Notes, TargetNullValue=—}"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="" Width="210" MinWidth="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✕"
                                            Width="26" Height="26" Padding="0" FontSize="12"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Delete"/>
                                    <Button Content="Move to inventory"
                                            Margin="10,0,0,0" Padding="10,4" FontSize="12"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.MoveToInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding EditItemCommand}"
                                  CommandParameter="{Binding ElementName=ItemsGrid, Path=SelectedItem}"/>
                </DataGrid.InputBindings>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
