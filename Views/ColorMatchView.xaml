<UserControl x:Class="MyCraftyStash.Views.ColorMatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MyCraftyStash.Views"
             Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar (same shape as SocialView) -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0">

                <!-- DMC Floss tab -->
                <Border Padding="16,12" Cursor="Hand" Margin="0,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveColorMatchTab}" Value="DMC">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowDmcCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✦" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="DMC Floss" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveColorMatchTab}" Value="DMC">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- OLO Marker tab -->
                <Border Padding="16,12" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,3"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveColorMatchTab}" Value="OLO">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowOloCommand}"/>
                    </Border.InputBindings>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="OLO Marker" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveColorMatchTab}" Value="OLO">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <!-- Tab content -->
        <Grid Grid.Row="1">
            <views:SystemColorMatchView DataContext="{Binding DmcVM}">
                <views:SystemColorMatchView.Style>
                    <Style TargetType="views:SystemColorMatchView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ActiveColorMatchTab, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="DMC">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SystemColorMatchView.Style>
            </views:SystemColorMatchView>

            <views:SystemColorMatchView DataContext="{Binding OloVM}">
                <views:SystemColorMatchView.Style>
                    <Style TargetType="views:SystemColorMatchView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ActiveColorMatchTab, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="OLO">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SystemColorMatchView.Style>
            </views:SystemColorMatchView>
        </Grid>
    </Grid>
</UserControl>
