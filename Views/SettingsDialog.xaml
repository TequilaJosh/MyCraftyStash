            <TabItem Header="Custom Sort" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Custom sort" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Grid.Row="1" Text="Set a custom sort order for each item type. These override the global sort for that type."
                                   Style="{StaticResource SectionHelp}"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ListBox x:Name="CustomSortTypesList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}"
                                         SelectionChanged="CustomSortTypesList_SelectionChanged"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                <StackPanel x:Name="CustomSortEditor" IsEnabled="False">
                                    <TextBlock x:Name="CustomSortEditorLabel"
                                               Text="Select a type to configure its sort order"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,16"
                                               FontSize="14"/>
                                    <TextBlock Text="1st Sort" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="Sort1Combo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,16"
                                              SelectionChanged="SortCombo_Changed"/>
                                    <TextBlock Text="2nd Sort" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="Sort2Combo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,16"
                                              SelectionChanged="SortCombo_Changed"/>
                                    <TextBlock Text="3rd Sort" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="Sort3Combo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,0"
                                              SelectionChanged="SortCombo_Changed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="3" x:Name="CustomSortSavedText"
                                   Text="Saved" Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                   Visibility="Collapsed" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Tracked Items" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Tracked items" Style="{StaticResource SectionHeading}"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Choose which item types are tracked. Select a tracked type on the right to set its warning levels."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="These settings are shared across all users."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="All Types" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="AllTypesList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             SelectionMode="Extended"
                                             MinHeight="260">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="Ctrl/Shift to multi-select"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                <Button Width="30" Height="30" Margin="0,0,0,8"
                                        ToolTip="Add to tracked"
                                        Click="AddToTracked_Click">
                                    <TextBlock Text=">" FontSize="13" FontWeight="Bold" Foreground="Black"/>
                                </Button>
                                <Button Width="30" Height="30"
                                        ToolTip="Remove from tracked"
                                        Click="RemoveFromTracked_Click">
                                    <TextBlock Text="&lt;" FontSize="13" FontWeight="Bold" Foreground="Black"/>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Tracked Types" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,6"/>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="TrackedTypesList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             SelectionMode="Single"
                                             MaxHeight="160"
                                             SelectionChanged="TrackedTypesList_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>

                                <Border Grid.Row="2" Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock x:Name="WarningEditorLabel"
                                                   Text="Select a tracked type to set its warning levels"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,0,0,10" TextWrapping="Wrap"/>

                                        <Grid x:Name="WarningLevelsGrid" IsEnabled="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Width="10" Height="10" Background="{DynamicResource SuccessBrush}" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Good at ≥" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource SuccessBrush}"/>
                                                </StackPanel>
                                                <TextBox x:Name="GoodThresholdBox"
                                                         Style="{StaticResource SearchTextBox}"
                                                         ToolTip="Stock at or above this number is shown in green"
                                                         TextChanged="WarningThreshold_Changed"/>
                                                <TextBlock Text="units (green)" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Width="10" Height="10" Background="{DynamicResource WarnBrush}" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Low at ≥" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource WarnBrush}"/>
                                                </StackPanel>
                                                <TextBox x:Name="LowThresholdBox"
                                                         Style="{StaticResource SearchTextBox}"
                                                         ToolTip="Stock at or above this (but below Good) is shown in yellow"
                                                         TextChanged="WarningThreshold_Changed"/>
                                                <TextBlock Text="units (yellow)" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Width="10" Height="10" Background="{DynamicResource DangerBrush}" CornerRadius="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Out at ≤" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </StackPanel>
                                                <TextBox x:Name="OutThresholdBox"
                                                         Style="{StaticResource SearchTextBox}"
                                                         ToolTip="Stock at or below this number is shown in red (default 0)"
                                                         TextChanged="WarningThreshold_Changed"/>
                                                <TextBlock Text="units (red)" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="e.g. Good ≥ 50 · Low ≥ 10 · Out ≤ 0"
                                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save Tracked Types"
                                    Click="SaveTrackedTypes_Click"/>
                            <TextBlock x:Name="TrackedTypesSavedText" Text="Saved"
                                       Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Project Tracked Items" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Project tracked items" Style="{StaticResource SectionHeading}"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Choose which projects appear in the Project Inventory tab of the Stock Tracker."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="These settings are shared across all users."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="All Projects" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="AllProjectsList"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             SelectionMode="Extended" MinHeight="260">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="Ctrl/Shift to multi-select"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                                <Button Width="30" Height="30" Margin="0,0,0,8"
                                        ToolTip="Add to tracked" Click="AddProjectToTracked_Click">
                                    <TextBlock Text=">" FontSize="13" FontWeight="Bold" Foreground="Black"/>
                                </Button>
                                <Button Width="30" Height="30"
                                        ToolTip="Remove from tracked" Click="RemoveProjectFromTracked_Click">
                                    <TextBlock Text="&lt;" FontSize="13" FontWeight="Bold" Foreground="Black"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tracked Projects" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="TrackedProjectsList"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrush}"
                                             SelectionMode="Extended" MinHeight="260">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save Project Tracked Items"
                                    Click="SaveProjectTrackedItems_Click"/>
                            <TextBlock x:Name="ProjectTrackedSavedText" Text="Saved"
                                       Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Cloud Sync" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeading}" Text="Cloud Sync"/>
                            <TextBlock Style="{StaticResource SectionHelp}"
                                       Text="Push your stash to the My Crafty Stash cloud so you can browse it read-only from your phone. The desktop stays the source of truth: edits happen here and get mirrored upward. Mint an API key on the website, paste it below, hit Test, then Sync."/>

                            <!-- Endpoint URL -->
                            <TextBlock Text="Endpoint URL" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <TextBox x:Name="CloudEndpointBox"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Padding="8,6"/>
                            <TextBlock Text="The base URL of your Static Web App. Usually https://wonderful-meadow-0a1a40110.7.azurestaticapps.net (or your custom domain). No trailing slash."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>

                            <!-- API key -->
                            <TextBlock Text="API key" FontWeight="SemiBold" Margin="0,8,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="CloudApiKeyBox" Grid.Column="0"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Padding="8,6"/>
                                <Button Grid.Column="1" Content="Clear"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="14,4" Margin="8,0,0,0"
                                        Click="CloudClearKey_Click"/>
                            </Grid>
                            <TextBlock x:Name="CloudKeyStatusText"
                                       Text="No API key saved." FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,12"/>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="CloudTestButton" Content="Test connection"
                                        Style="{StaticResource SecondaryButton}" Padding="16,6"
                                        Click="CloudTest_Click"/>
                                <Button x:Name="CloudSaveButton" Content="Save"
                                        Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0"
                                        Click="CloudSave_Click"/>
                                <Button x:Name="CloudSyncButton" Content="Sync now"
                                        Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0"
                                        Click="CloudSync_Click"/>
                                <Button x:Name="CloudCancelButton" Content="Cancel sync"
                                        Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0"
                                        IsEnabled="False"
                                        Click="CloudCancel_Click"/>
                            </StackPanel>

                            <!-- Status / progress -->
                            <Border Margin="0,16,0,0" Padding="12"
                                    Background="{DynamicResource SidebarBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock x:Name="CloudStatusText"
                                               Text="Not yet synced."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ProgressBar x:Name="CloudProgressBar"
                                                 Height="6" Margin="0,8,0,0"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Clear cloud data -->
                            <TextBlock Text="Reset" FontWeight="SemiBold" Margin="0,20,0,4"/>
                            <TextBlock Text="If you want to start fresh, wipe the local sync state so the next Sync uploads everything again. (To delete what's already in the cloud, revoke the key from the website.)"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="Reset local sync state"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,6" HorizontalAlignment="Left"
                                    Click="CloudResetLocal_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Catalog Sources" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionHeading}" Text="Catalog sources"/>
                            <TextBlock Style="{StaticResource SectionHelp}"
                                       Text="When you click ‘Look Up Item’, every enabled retailer is searched in parallel and results are merged with a source badge. Toggle a row to add or remove that retailer from your searches. Stubbed sources have no scraper yet — they're listed for future support."/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ListView x:Name="CatalogSourcesList"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource TextBrush}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsToggleable}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          Click="CatalogSource_Toggled"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                                        <Border Padding="6,1" Margin="8,0,0,0"
                                                                CornerRadius="3"
                                                                Background="{DynamicResource SidebarBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Visibility="{Binding IsStub, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="not yet supported" FontSize="10"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Domain}" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                           FontSize="11" FontStyle="Italic"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Text="{Binding StatusText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- The "Version" tab moved to the new About dialog (sidebar →
                 About) so it isn't buried under Settings. -->

        </TabControl>

        <Button Grid.Row="2" Content="Close" Click="CloseButton_Click"
                Style="{StaticResource SecondaryButton}" Padding="24,8"
                HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Window>
