<Window x:Class="MyCraftyStash.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="680" Width="940"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="520" MinWidth="780"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <!-- Sidebar nav item: full-width, left-aligned, subtle hover, primary fill when selected. -->
        <Style x:Key="SidebarTabItem" TargetType="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab content panel — soft surface card to separate from the sidebar. -->
        <Style x:Key="ContentPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHelp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="4,0,0,12"/>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <!-- Make the side strip itself look like a sidebar panel. -->
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
                    <Setter Property="MinWidth" Value="200"/>
                </Style>
            </TabControl.Resources>
            <TabControl.Template>
                <!--
                    Custom TabControl template: wraps the left tab strip in a vertical
                    ScrollViewer so overflowed nav items remain reachable at small window
                    sizes. The right-hand content presenter is unchanged.
                -->
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="True"
                          KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource SidebarBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          MinWidth="200"
                                          KeyboardNavigation.TabIndex="1"/>
                            </ScrollViewer>
                        </Border>

                        <ContentPresenter Grid.Column="1"
                                          x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="Display" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Display" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="These display preferences are saved per user and apply only to you."
                                       Style="{StaticResource SectionHelp}"/>

                            <TextBlock Text="Appearance" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton x:Name="LightModeRadio" Content="Light Mode"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,24,0"
                                             GroupName="Theme"
                                             Checked="ThemeRadio_Changed"/>
                                <RadioButton x:Name="DarkModeRadio" Content="Dark Mode"
                                             Foreground="{DynamicResource TextBrush}"
                                             GroupName="Theme"
                                             Checked="ThemeRadio_Changed"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Card Size" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Controls the size of item cards in the inventory list."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton x:Name="CardSizeSmall" Content="Small"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,24,0"
                                             GroupName="CardSize"
                                             Checked="CardSizeRadio_Changed"/>
                                <RadioButton x:Name="CardSizeMedium" Content="Medium"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,24,0"
                                             GroupName="CardSize"
                                             Checked="CardSizeRadio_Changed"/>
                                <RadioButton x:Name="CardSizeLarge" Content="Large"
                                             Foreground="{DynamicResource TextBrush}"
                                             GroupName="CardSize"
                                             Checked="CardSizeRadio_Changed"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Text Size" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Controls the font size throughout the application."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <RadioButton x:Name="TextSizeSmall" Content="Small"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,24,0"
                                             GroupName="TextSize"
                                             Checked="TextSizeRadio_Changed"/>
                                <RadioButton x:Name="TextSizeMedium" Content="Medium"
                                             Foreground="{DynamicResource TextBrush}"
                                             Margin="0,0,24,0"
                                             GroupName="TextSize"
                                             Checked="TextSizeRadio_Changed"/>
                                <RadioButton x:Name="TextSizeLarge" Content="Large"
                                             Foreground="{DynamicResource TextBrush}"
                                             GroupName="TextSize"
                                             Checked="TextSizeRadio_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Colors" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Personal colors" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Style="{StaticResource SectionHelp}">
                                Pick a swatch or enter a hex code (e.g. <Run FontFamily="Consolas">#A82C32</Run>) to override the default UI colors. Your choices are saved to your local profile only and apply on top of the current Light/Dark theme. Use <Run FontWeight="SemiBold">Reset</Run> to return any color to the theme default.
                            </TextBlock>

                            <ItemsControl x:Name="ColorPickersHost">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="0,12,0,16" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Border x:Name="Swatch" Width="34" Height="34"
                                                                CornerRadius="6"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                Background="{Binding CurrentBrush}"
                                                                VerticalAlignment="Center"/>
                                                        <TextBox Width="110"
                                                                 Margin="10,0,0,0"
                                                                 Padding="8,6"
                                                                 VerticalContentAlignment="Center"
                                                                 FontFamily="Consolas"
                                                                 Background="{DynamicResource InputBackgroundBrush}"
                                                                 Foreground="{DynamicResource TextBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                                 Tag="{Binding Key}"
                                                                 Text="{Binding HexValue, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="ColorHex_KeyDown"
                                                                 LostFocus="ColorHex_LostFocus"/>
                                                        <Button Content="Pick…"
                                                                Margin="6,0,0,0"
                                                                Padding="14,6"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Tag="{Binding Key}"
                                                                Click="OpenColorPicker_Click"/>
                                                        <Button Content="Apply"
                                                                Margin="6,0,0,0"
                                                                Padding="14,6"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Tag="{Binding Key}"
                                                                Click="ApplyColor_Click"/>
                                                        <Button Content="Reset"
                                                                Margin="6,0,0,0"
                                                                Padding="14,6"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Tag="{Binding Key}"
                                                                Click="ResetColor_Click"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Presets}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Width="22" Height="22"
                                                                        Margin="0,0,4,4"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding}"
                                                                        Click="PresetSwatch_Click"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd"
                                                                                    Background="{Binding}"
                                                                                    CornerRadius="4"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Reset all colors to theme defaults"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="18,8"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,0"
                                    Click="ResetAllColors_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Item Defaults" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="Item defaults" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="Set default values that are pre-filled when adding new items."
                                       Style="{StaticResource SectionHelp}"/>

                            <TextBlock Text="Default Item Type" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>
                            <ComboBox x:Name="DefaultTypeCombo" Width="300" HorizontalAlignment="Left"
                                      Background="{DynamicResource CardBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Padding="8,6"
                                      Margin="0,0,0,20"
                                      SelectionChanged="DefaultType_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Default Location" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,8"/>
                            <ComboBox x:Name="DefaultLocationCombo" Width="300" HorizontalAlignment="Left"
                                      Background="{DynamicResource CardBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Padding="8,6"
                                      Margin="0,0,0,20"
                                      SelectionChanged="DefaultLocation_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Default Sort Order" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Controls how items are sorted in the inventory list. Color-sorted items (Ink, Watercolor, Cardstock, Envelopes) always keep their color order."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <ComboBox x:Name="DefaultSortCombo" Width="300" HorizontalAlignment="Left"
                                      Background="{DynamicResource CardBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Padding="8,6"
                                      Margin="0,0,0,20"
                                      SelectionChanged="DefaultSort_Changed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Types" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Types" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Grid.Row="1" Text="Edit item types below, one per line. These appear in the Type dropdown."
                                   Style="{StaticResource SectionHelp}"/>
                        <TextBox Grid.Row="2" x:Name="TypesTextBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Padding="8,6"
                                 FontFamily="Segoe UI"
                                 TextWrapping="NoWrap"/>
                        <Button Grid.Row="3" Content="Save Types" Click="SaveTypes_Click"
                                Style="{StaticResource PrimaryButton}" Padding="24,8"
                                HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Subtypes" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Subtypes" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Grid.Row="1"
                                   Text="Select a type on the left, then enter its subtypes (one per line) on the right."
                                   Style="{StaticResource SectionHelp}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ListBox x:Name="SubtypeTypesList"
                                         Background="{DynamicResource CardBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="0"
                                         SelectionChanged="SubtypeTypesList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SubtypeEditorLabel" Grid.Row="0"
                                               Text="Select a type to edit its subtypes"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" Margin="10,8,10,6"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="SubtypesTextBox"
                                             Grid.Row="1"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource CardBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="10,6"
                                             FontFamily="Segoe UI"
                                             FontSize="13"
                                             IsEnabled="False"
                                             TextWrapping="NoWrap"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button Grid.Row="3" Content="Save Subtypes" Click="SaveSubtypes_Click"
                                Style="{StaticResource PrimaryButton}" Padding="24,8"
                                HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Card Builder Labels" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Card Builder Labels" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Grid.Row="1"
                                   Text="Pick a wizard label on the left, then choose which inventory Type and Subtypes feed its dropdowns. All matching is case-insensitive contains."
                                   Style="{StaticResource SectionHelp}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <ListBox x:Name="CardLabelList"
                                         Background="{DynamicResource CardBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderThickness="0"
                                         SelectionChanged="CardLabelList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="CardLabelEditorTitle" Grid.Row="0"
                                               Text="Select a label to edit"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" Margin="12,10,12,8" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1" Text="Inventory Type"
                                               Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                               FontSize="12" Margin="12,4,12,4"/>
                                    <ComboBox x:Name="CardLabelTypeBox" Grid.Row="2"
                                              Margin="12,0,12,4" Padding="8,6"
                                              IsEditable="True" IsTextSearchEnabled="True"
                                              IsEnabled="False"/>

                                    <TextBlock Grid.Row="3"
                                               Text="Subtypes (one per line — matched as contains; leave blank for no subtype filter)"
                                               Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                               FontSize="12" Margin="12,8,12,4"/>
                                    <TextBox x:Name="CardLabelSubtypesBox" Grid.Row="4"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="{DynamicResource CardBrush}"
                                             Foreground="{DynamicResource TextBrush}"
                                             BorderThickness="0"
                                             Padding="10,6"
                                             FontFamily="Segoe UI"
                                             FontSize="13"
                                             IsEnabled="False"
                                             TextWrapping="NoWrap"/>

                                    <TextBlock Grid.Row="5"
                                               Text="Name contains (only used by name-search labels like 'All Planned Out')"
                                               Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                               FontSize="12" Margin="12,8,12,4"/>
                                    <TextBox x:Name="CardLabelNameContainsBox" Grid.Row="6"
                                             Margin="12,0,12,10" Padding="8,6"
                                             FontSize="13" IsEnabled="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <DockPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button DockPanel.Dock="Left" Content="Reset to defaults"
                                    Click="ResetCardLabels_Click"
                                    Style="{StaticResource SecondaryButton}" Padding="18,8"/>
                            <Button DockPanel.Dock="Right" Content="Save label"
                                    Click="SaveCardLabel_Click"
                                    Style="{StaticResource PrimaryButton}" Padding="24,8"
                                    HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Themes" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Themes" Style="{StaticResource SectionHeading}"/>
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Edit themes below, one per line. These appear in the Theme checkboxes."
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="Add * before the theme name if it needs a specific year or more info (e.g. *Combo Club)"
                                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" x:Name="ThemesTextBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource CardBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Padding="8,6"
                                 FontFamily="Segoe UI"
                                 TextWrapping="NoWrap"/>
                        <Button Grid.Row="3" Content="Save Themes" Click="SaveThemes_Click"
                                Style="{StaticResource PrimaryButton}" Padding="24,8"
                                HorizontalAlignment="Right" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Color Order" Style="{StaticResource SidebarTabItem}">
                <Border Style="{StaticResource ContentPanel}" Margin="12,0,0,0">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Color order" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Grid.Row="1"
                                   Text="Edit the color sort order below, one per line. Ink, Watercolor, Cardstock, and Envelope items are sorted by the position of their matching color in this list."
                                   Style="{StaticResource SectionHelp}"/>
                        <TextBox Grid.Row="2" x:Name="ColorOrderTextBox"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
