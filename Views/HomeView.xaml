<UserControl x:Class="MyCraftyStash.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyCraftyStash.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <StackPanel Margin="32,24,32,32">

                <!-- Header / breadcrumb -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Breadcrumb}" Text="{StaticResource AppName}"/>
                            <TextBlock Style="{StaticResource Breadcrumb}" Text="  /  "/>
                            <TextBlock Style="{StaticResource Breadcrumb}" Text="Home"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Margin="0,4,0,0"
                                   Text="Welcome Josh &amp; Heather"/>
                        <TextBlock Style="{StaticResource PageSubtitle}"
                                   Text="Here's what's happening in your craft room."/>
                    </StackPanel>
                </Grid>

                <!-- Stat cards row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,8,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.NavigateToInventoryCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="TOTAL ITEMS"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalItems}"/>
                            <TextBlock Style="{StaticResource StatHint}"
                                       Foreground="{DynamicResource SuccessBrush}">
                                <Run Text="▲"/>
                                <Run Text="{Binding ItemsAddedThisMonth, Mode=OneWay}"/>
                                <Run Text=" this month"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0,8,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.NavigateToSentimentSearchCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="SENTIMENTS INDEXED"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding SentimentsIndexed}"/>
                            <TextBlock Style="{StaticResource StatHint}">
                                <Run Text="across "/>
                                <Run Text="{Binding CategoryCount, Mode=OneWay}"/>
                                <Run Text=" categories"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="8,0,8,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.NavigateToStockTrackingCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="LOW / OUT"/>
                            <TextBlock Style="{StaticResource StatValue}"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Text="{Binding LowOrOutCount}"/>
                            <TextBlock Style="{StaticResource StatHint}" Text="needs reorder"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource PanelCard}" Margin="8,0,0,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.NavigateToProjectsCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="PROJECTS"/>
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ProjectCount}"/>
                            <TextBlock Style="{StaticResource StatHint}"
                                       Foreground="{DynamicResource SuccessBrush}">
                                <Run Text="▲"/>
                                <Run Text="{Binding ProjectsAddedThisMonth, Mode=OneWay}"/>
                                <Run Text=" this month"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Two-column row: Running low + Recent projects -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Running low panel -->
                    <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="Running low"/>
                                <Button Grid.Column="1" Style="{StaticResource NavButton}"
                                        Padding="6,2"
                                        Command="{Binding DataContext.NavigateToStockTrackingCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               Text="View all →"/>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RunningLow}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4" Background="Transparent" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.NavigateToItemCommand,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Id}"/>
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource BadgeBrush}">
                                                <TextBlock Text="{Binding TypeBadge}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Sku}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <Grid Grid.Column="2" Height="6" VerticalAlignment="Center"
                                                  Margin="0,0,12,0">
                                                <Border Background="{DynamicResource BorderSoftBrush}"
                                                        CornerRadius="999"/>
                                                <Border HorizontalAlignment="Left"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="999"
                                                        Width="{Binding StockPercent}"/>
                                            </Grid>

                                            <Border Grid.Column="3" Style="{StaticResource PillDanger}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StockLabel}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nothing running low — nice work."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding RunningLow.Count, Converter={StaticResource ZeroToVisConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent projects panel -->
                    <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="Recent projects"/>
                                <Button Grid.Column="1" Style="{StaticResource NavButton}"
                                        Padding="6,2"
                                        Command="{Binding DataContext.NavigateToProjectsCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               Text="View all →"/>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4" Padding="0"
                                                Background="{DynamicResource BorderSoftBrush}"
                                                CornerRadius="10"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.NavigateToProjectCommand,
                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Id}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <Border Height="120"
                                                        Background="{DynamicResource BadgeBrush}"
                                                        CornerRadius="10,10,0,0"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ImageConverter}, ConverterParameter=300, TargetNullValue={x:Null}}"
                                                           Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Margin="12,8,12,12">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0">
                                                        <Run Text="{Binding DateLabel}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding SupplyCount, Mode=OneWay}"/>
                                                        <Run Text=" supplies"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No projects yet — start your first one."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontStyle="Italic"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding RecentProjects.Count, Converter={StaticResource ZeroToVisConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
