<Window x:Class="MyCraftyStash.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Inventory"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Export Inventory" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
        <TextBlock Text="Choose what to include in your export."
                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <RadioButton x:Name="CsvOnlyRadio" Content="CSV spreadsheet only"
                             IsChecked="True" FontSize="13" Margin="0,0,0,6"
                             Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Exports all inventory fields to a .csv file you can open in Excel."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,0,0"/>

                <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,14,0,14"/>

                <RadioButton x:Name="CsvAndImagesRadio" Content="CSV + all item photos (ZIP)"
                             FontSize="13" Margin="0,0,0,6"
                             Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="Creates a ZIP with the CSV plus photos sorted into Type/ItemName folders."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="ProgressArea" Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="ProgressLabel" Text="Exporting..." FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100"
                             Value="0" Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ResultLabel" Text="" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Padding="20,9" Margin="0,0,12,0" Click="CancelBtn_Click"/>
            <Button x:Name="ExportBtn" Content="Export" Style="{StaticResource PrimaryButton}"
                    Padding="20,9" Click="ExportBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
