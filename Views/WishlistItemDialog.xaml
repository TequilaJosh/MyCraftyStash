<Window x:Class="MyCraftyStash.Views.WishlistItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wish list item"
        Width="600" SizeToContent="Height"
        MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Look up TE item"
                        Style="{StaticResource SecondaryButton}" Padding="14,7"
                        Click="LookUp_Click"/>
                <TextBlock x:Name="HeaderText" Text="Add item" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,8">
                <TextBlock Text="Name *" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TypeBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Item number" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ItemNumberBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estimated price" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Priority" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PriorityBox" Padding="10,7" FontSize="13">
                            <ComboBoxItem Content="Low" Tag="1"/>
                            <ComboBoxItem Content="Medium" Tag="2"/>
                            <ComboBoxItem Content="High" Tag="3"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Store" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                <TextBox x:Name="StoreBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>

                <TextBlock Text="Product URL" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                <TextBox x:Name="UrlBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>

                <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                <TextBox x:Name="ThemeBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>

                <TextBlock Text="Note" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                <TextBox x:Name="NotesBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
