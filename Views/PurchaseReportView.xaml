<UserControl x:Class="MyCraftyStash.Views.PurchaseReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="32,22,32,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Breadcrumb}" Text="My Crafty Stash"/>
                    <TextBlock Style="{StaticResource Breadcrumb}" Text="  /  "/>
                    <TextBlock Style="{StaticResource Breadcrumb}" Text="Expense report"/>
                </StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Purchase history" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Track and analyze your craft supply spending."/>
            </StackPanel>
        </Border>

        <!-- Filters bar -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportCsvCommand}" Padding="16,8" Margin="0,0,12,0"
                            Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisConverter}}"/>
                    <Button Content="Run Report" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadReportCommand}" Padding="16,8"/>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="From:" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="To:" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Group by:" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding GroupByOptions}" SelectedItem="{Binding SelectedGroupBy}"
                                  Width="130" Padding="10,7"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2">

            <!-- Loading overlay -->
            <Border Background="{DynamicResource BackgroundBrush}" Opacity="0.7"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="10">
                <TextBlock Text="Loading..." FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Empty / status -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="&#x1F4B3;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Choose a date range and click Run Report.'}"
                           FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="40,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisConverter}}"/>

            <!-- Results -->
            <Grid Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary strip -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL SPEND" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalSpend, StringFormat='${0:N2}'}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="ITEMS PURCHASED" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalItems}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="UNIQUE ITEMS" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding UniqueItems}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="16,10">
                            <StackPanel>
                                <TextBlock Text="AVG PER ITEM" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding AveragePerItem, StringFormat='${0:N2}'}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>

                <!-- Grouped rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GroupedRows}" Margin="24,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Group header -->
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding Count, StringFormat='{}{0} purchase(s)'}"
                                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <TextBlock Text="{Binding Total, StringFormat='${0:N2}'}"
                                                           FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Column headers -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Item" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="Type" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="2" Text="Date" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="3" Text="Qty" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="Each" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="5" Text="Total" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <!-- Row data -->
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="90"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding ItemName}" FontSize="13"
                                                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding ItemNumber, StringFormat='#{0}', TargetNullValue=''}"
                                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding ItemType}" FontSize="12"
                                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Date, StringFormat='MMM d, yyyy', TargetNullValue='-'}"
                                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Quantity}" FontSize="12"
                                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding PricePerItem, StringFormat='${0:F2}'}"
                                                                       FontSize="12" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding LineTotal, StringFormat='${0:F2}'}"
                                                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
