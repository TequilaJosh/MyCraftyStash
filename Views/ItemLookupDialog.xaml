<Window x:Class="MyCraftyStash.Views.ItemLookupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyCraftyStash.Converters"
        Title="Look Up Catalog Item"
        Height="600" Width="820"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:Base64ImageConverter x:Key="Base64ImageConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="Look Up Catalog Item"
                           FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Searches your enabled retailer sites (TE, Altenew, Hero Arts, Lawn Fawn…) in parallel. Each result shows the source it came from. Manage sources in Settings → Catalog Sources."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             FontSize="13" Padding="10,8"
                             Background="{DynamicResource CardBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button x:Name="SearchButton"
                            Grid.Column="2"
                            Content="Search"
                            Padding="20,8" FontSize="13"
                            Click="SearchButton_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Results + Preview -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Results list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,7"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock x:Name="StatusText"
                                   Text="Enter a name or item number to search"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>

                    <TextBlock x:Name="LoadingText"
                               Grid.Row="1"
                               Text="Searching..."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="NoResultsPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Text="No items found"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a shorter or different search term"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="ResultsList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="ResultsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="4"
                                                Background="{DynamicResource SidebarBrush}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource Base64ImageConverter}}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Type}"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text=" · " FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding ItemNumber, Converter={StaticResource NullToVisConverter}}"/>
                                                <TextBlock Text="{Binding ItemNumber}"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding ItemNumber, Converter={StaticResource NullToVisConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- Retailer badge — tells the user which site this result came from. -->
                                                <Border Padding="6,1"
                                                        CornerRadius="3"
                                                        Margin="0,0,4,0"
                                                        Background="{DynamicResource SidebarBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding Source, Converter={StaticResource NullToVisConverter}}">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <Border Padding="6,1"
                                                        CornerRadius="3"
                                                        Background="#FFE9F2DC"
                                                        BorderBrush="#FF7CA94C"
                                                        BorderThickness="1"
                                                        Visibility="{Binding IsAlreadyInInventory, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="In your inventory"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#FF3F6B1F"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Preview -->
            <Grid Grid.Column="1">

                <StackPanel x:Name="EmptyPreview"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Select an item to preview"
                               FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="All fields can be edited before saving"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="PreviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              Padding="20,16"
                              Visibility="Collapsed">
                    <StackPanel>

                        <!-- Duplicate-in-inventory banner -->
                        <Border x:Name="DuplicateBanner"
                                Background="#FFFFF4D6"
                                BorderBrush="#FFE0B341"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="ALREADY IN YOUR INVENTORY"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8A5A00"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="DuplicateBannerText"
                                           FontSize="12"
                                           Foreground="#FF6B4500"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Image area -->
                        <Border x:Name="ImageArea"
                                Background="{DynamicResource SidebarBrush}"
                                CornerRadius="8" Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Border Height="200" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Image x:Name="PreviewImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ScrollViewer x:Name="ThumbStrip"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Padding="8,6" Visibility="Collapsed">
                                    <StackPanel x:Name="ThumbPanel" Orientation="Horizontal"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Name -->
                        <TextBlock x:Name="PreviewName"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Type + Item Number -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="TYPE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PreviewType"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ITEM NUMBER" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PreviewItemNumber"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Theme + Price -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="THEME" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PreviewTheme"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PRICE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PreviewPrice"
                                           FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- What will be copied -->
                        <Border Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="WILL BE COPIED INTO FORM"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ImportSummary"
                                           FontSize="12" Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <DockPanel>
                <TextBlock x:Name="FooterHint"
                           Text="You can edit all pre-filled fields before saving the new item."
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Cancel"
                            Padding="18,7" Margin="0,0,10,0" FontSize="13"
                            Click="CancelButton_Click"
                            Background="{DynamicResource SidebarBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="ImportButton"
                            Content="Copy to Form"
                            Padding="18,7" FontSize="13"
                            IsEnabled="False"
                            Click="ImportButton_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
