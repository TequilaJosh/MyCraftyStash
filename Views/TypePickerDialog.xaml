<Window x:Class="MyCraftyStash.Views.TypePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick an item type"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Pick an item type" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"/>
                <TextBlock x:Name="SubtitleText"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="20,18,20,18">
            <TextBlock Text="Moving to inventory:" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="ItemNameText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="OriginalTypeText" FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Item type" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TypeCombo" FontSize="13" Padding="10,7" Height="34"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,10,0"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Move to inventory" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
