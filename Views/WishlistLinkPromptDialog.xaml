<Window x:Class="MyCraftyStash.Views.WishlistLinkPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from link"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Import from link" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,3"/>
                <TextBlock Text="Paste a product URL — we'll pre-fill the item from the page."
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18,20,8">
            <TextBlock Text="URL" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="UrlBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                       FontSize="12" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="FetchButton" Content="Fetch" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        Click="Fetch_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
