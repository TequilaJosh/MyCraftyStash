<UserControl x:Class="MyCraftyStash.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MyCraftyStash.ViewModels"
             xmlns:views="clr-namespace:MyCraftyStash.Views"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Day header style -->
        <Style x:Key="DayHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- LEFT: Calendar Grid                                              -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Month navigation header -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="◀"
                                Command="{Binding PreviousMonthCommand}"
                                Width="34" Height="34" Padding="0" FontSize="13"/>
                        <TextBlock Text="{Binding CurrentMonthLabel}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" Margin="16,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="▶"
                                Command="{Binding NextMonthCommand}"
                                Width="34" Height="34" Padding="0" FontSize="13"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Today"
                                Command="{Binding GoToTodayCommand}"
                                Padding="12,6" Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- Loading indicator -->
                    <TextBlock Text="Loading..." Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Day-of-week headers -->
            <Grid Grid.Row="1" Background="{DynamicResource CardBrush}"
                  Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SUN" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="1" Text="MON" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="2" Text="TUE" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="3" Text="WED" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="4" Text="THU" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="5" Text="FRI" Style="{StaticResource DayHeaderText}"/>
                <TextBlock Grid.Column="6" Text="SAT" Style="{StaticResource DayHeaderText}"/>
            </Grid>

            <!-- Calendar cells grid (6 rows × 7 cols = 42 cells) -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding DayCells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="6" Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1"
                                MinHeight="80" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectDayCellCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid Margin="4,4,4,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Day number -->
                                <Grid Grid.Row="0">
                                    <Border HorizontalAlignment="Left" Width="26" Height="26"
                                            CornerRadius="13">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Date.Day}" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Event chips (up to 3) -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Events}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Margin="0,1" Padding="4,1"
                                                    Background="{DynamicResource PrimaryBrush}">
                                                <TextBlock Text="{Binding Title}" FontSize="10" Foreground="White"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- RIGHT: Day detail + Event form panel                            -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Background="{DynamicResource SidebarBrush}">
            <Grid>

                <!-- Day Events Panel (visible when not editing/adding) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected day header -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Select a day"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Select a day"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SelectedDay.Date, Mode=OneWay, StringFormat='dddd, MMMM d', FallbackValue=''}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding SelectedDayEvents.Count, Mode=OneWay, FallbackValue='0'}"/>
                                    <Run Text=" event(s)"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Content="+ Add Event"
                                    Command="{Binding StartAddCommand}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="10,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Status message -->
                    <StackPanel Grid.Row="1">
                        <Border Background="{DynamicResource SuccessSoftBrush}" Padding="12,8" Margin="12,8,12,0" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>

                        <!-- No day selected placeholder -->
                        <TextBlock Text="Click any day to view or add events."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="20,48,20,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDay}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- No events placeholder -->
                        <TextBlock Text="No events on this day. Click '+ Add Event' to create one."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="20,48,20,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedDayEvents.Count}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Events list -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                            <ItemsControl ItemsSource="{Binding SelectedDayEvents}" Margin="12,8,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Margin="0,0,0,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Color stripe -->
                                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,10,0"
                                                        Background="{DynamicResource PrimaryBrush}"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="180">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Edit / Delete buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource SecondaryButton}" Content="✏"
                                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Padding="0" FontSize="11" Margin="0,0,4,0"/>
                                                    <Button Content="✕"
                                                            Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                            CommandParameter="{Binding}"
                                                            Width="28" Height="28" Padding="0" FontSize="11">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ADD / EDIT FORM                                         -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Margin="16">

                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Edit Event"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                            <Setter Property="Text" Value="New Event"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Error Message -->
                        <Border Background="{DynamicResource DangerSoftBrush}" Padding="10,7" CornerRadius="6" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="Title *" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBox}" Padding="8,7" Margin="0,0,0,12"/>

                        <!-- Description -->
                        <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBox}" Padding="8,7"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Margin="0,0,0,12"/>

                        <!-- Date -->
                        <TextBlock Text="Date *" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EditDate}" Margin="0,0,0,12"
                                    Height="34" VerticalContentAlignment="Center"/>

                        <!-- All Day toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding EditIsAllDay}" VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="All Day Event" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Time picker (visible when not all-day) -->
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EditIsAllDay}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Time" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding EditTimeHour, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBox}" Width="48" Padding="8,7"
                                         MaxLength="2"/>
                                <TextBlock Text=":" FontSize="16" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBox Text="{Binding EditTimeMinute, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBox}" Width="48" Padding="8,7"
                                         MaxLength="2"/>
                                <ComboBox ItemsSource="{Binding AmPmOptions}"
                                          SelectedItem="{Binding EditTimeAmPm}"
                                          Width="56" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                          Height="34"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Reminder -->
                        <TextBlock Text="Remind me" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ReminderOptions}"
                                  SelectedItem="{Binding EditReminderLabel}"
                                  Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <!-- Color -->
                        <TextBlock Text="Color" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ColorOptions}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="28" Height="28" CornerRadius="14" Margin="3" Cursor="Hand"
                                            Background="{DynamicResource PrimaryBrush}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetColorCommand, RelativeSource={RelativeSource AncestorType=views:CalendarView}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Save / Cancel -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾 Save" Command="{Binding SaveEventCommand}"
                                    Padding="14,8" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel"
                                    Command="{Binding CancelFormCommand}" Padding="14,8"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
