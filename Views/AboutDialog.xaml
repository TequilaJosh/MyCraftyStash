<Window x:Class="MyCraftyStash.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource CardBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="12,12,0,0" Padding="24,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ⓘ" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="White"/>
                    <StackPanel>
                        <TextBlock Text="About" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="J and H Inventory"
                                   FontSize="12" Foreground="{DynamicResource PrimarySoftBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="24,20,24,4">

                <!-- Version block (moved here from Settings) -->
                <Border Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Installed Version:"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13" Width="160"/>
                            <TextBlock x:Name="InstalledVersionText"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Deployment Type:"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="13" Width="160"/>
                            <TextBlock x:Name="DeploymentTypeText"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Assembly Version:"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" Width="160"/>
                            <TextBlock x:Name="AssemblyVersionText"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckForUpdatesButton"
                                    Content="Check for updates"
                                    Click="CheckForUpdatesButton_Click"
                                    Padding="16,7" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock x:Name="UpdateStatusText"
                                       VerticalAlignment="Center"
                                       Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       MaxWidth="240"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Built-by + contact -->
                <TextBlock Text="Made by"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Silo Software Creations"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Contact"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0,4,0,4"/>
                <TextBlock Margin="0,0,0,4">
                    <Hyperlink x:Name="ContactEmailLink"
                               NavigateUri="mailto:Silosoftwarecreations@gmail.com"
                               RequestNavigate="ContactEmailLink_RequestNavigate"
                               Foreground="{DynamicResource PrimaryBrush}"
                               TextDecorations="Underline">
                        Silosoftwarecreations@gmail.com
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="For bug reports, feature requests, or anything else."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="11" FontStyle="Italic"
                           Margin="0,0,0,4"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="20,14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource BackgroundBrush}" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="CloseButton_Click"
                            Padding="20,8" FontSize="13">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
