<Window x:Class="MyCraftyStash.Views.WishlistListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wish list"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <TextBlock x:Name="HeaderText" Text="New list" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,18,20,0">
            <TextBlock Text="Name" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"/>

            <TextBlock Text="Color" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,16,0,6"/>
            <ItemsControl x:Name="SwatchList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,8,8" Cursor="Hand"
                                Tag="{Binding}" MouseLeftButtonDown="Swatch_Click"
                                BorderThickness="2">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding}"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Description" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
            <TextBox x:Name="DescriptionBox" Style="{StaticResource SearchTextBox}" Padding="10,9" FontSize="13"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
