<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>MyCraftyStash</AssemblyName>
    <RootNamespace>MyCraftyStash</RootNamespace>

    <!-- Version settings - update these when releasing new versions -->
    <Version>1.0.2.9</Version>
    <AssemblyVersion>1.0.2.9</AssemblyVersion>
    <FileVersion>1.0.2.9</FileVersion>
    <InformationalVersion>1.0.2.9</InformationalVersion>

    <!-- Populated assembly metadata. Empty version-info blocks are a known
         heuristic input for AV "RiskWare.Crack" / ML-anomalous false
         positives on unsigned managed binaries; filling these in makes the
         PE look like a normal LOB app to the classifier. -->
    <Company>My Crafty Stash</Company>
    <Product>My Crafty Stash</Product>
    <AssemblyTitle>My Crafty Stash</AssemblyTitle>
    <Description>Inventory and project management for craft supplies — stamps, dies, stencils, and card builds.</Description>
    <Copyright>Copyright © My Crafty Stash 2026</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
