<Window x:Class="MyCraftyStash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyCraftyStash.ViewModels"
        Title="{StaticResource AppName}"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Sidebar nav button (bigger, hover/selected states) -->
        <Style x:Key="SideNav" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selected state for sidebar nav -->
        <Style x:Key="SideNavSelected" TargetType="Button" BasedOn="{StaticResource SideNav}">
            <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
        </Style>

        <Style x:Key="SubNav" TargetType="Button" BasedOn="{StaticResource SideNav}">
            <Setter Property="Padding" Value="36,7,12,7"/>
        </Style>

        <!-- Pill count badge for sidebar -->
        <Style x:Key="SideBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BadgeBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title strip: brand bar -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                Height="{DynamicResource TitleBarHeight}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/icon.png"
                       Width="22" Height="22" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{StaticResource AppName}" Foreground="{DynamicResource TitleBarTextBrush}"
                           FontWeight="SemiBold" FontSize="{DynamicResource FontMd}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Foreground="White"
                           FontSize="{DynamicResource FontSm}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="— "/><Run Text="{StaticResource OrgSubtitle}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar width: keep in sync with App.xaml SidebarWidth token (248) -->
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ─────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Brand card -->
                    <Border DockPanel.Dock="Top" Margin="14,14,14,8" Padding="12"
                            Background="{DynamicResource SidebarSelectedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/icon.png"
                                   Width="34" Height="34" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="My Crafty Stash" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- About + Settings pinned to bottom, stacked. Icon TextBlocks get
                         a fixed width and HorizontalAlignment=Left so the optical left
                         edge of ⚙/ⓘ (which are circular and inset inside their own glyph
                         box) lines up with the chunkier nav icons above. Negative left
                         margin pulls the glyphs flush with the buttons' content padding. -->
                    <Border DockPanel.Dock="Bottom" Margin="10,0,10,12">
                        <Button Style="{StaticResource SideNav}"
                                Command="{Binding OpenAboutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Width="22" Margin="-2,0,4,0"
                                           TextAlignment="Left"/>
                                <TextBlock Text="About" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Margin="10,0,10,4">
                        <Button Style="{StaticResource SideNav}"
                                Command="{Binding OpenSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Width="22" Margin="-2,0,4,0"
                                           TextAlignment="Left"/>
                                <TextBlock Text="Settings" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Margin="10,8,10,4">
                        <Button Style="{StaticResource SideNav}"
                                Click="KoFiButton_Click"
                                ToolTip="Support My Crafty Stash on Ko-fi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☕" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Width="22" Margin="-2,0,4,0"
                                           TextAlignment="Left"/>
                                <TextBlock Text="Support on Ko-fi" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Scrollable nav body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,4,10,8">

                            <!-- OVERVIEW -->
                            <Button Command="{Binding NavigateToHomeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⌂" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Home" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- ITEMS (current order: Inventory, then submenu, then Sentiment Search, Inspiration, Wish List) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding NavigateToInventoryCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Inventory">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◰" FontSize="14" Margin="2,0,10,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Inventory" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ToggleButton Grid.Column="1" x:Name="InventoryToggle"
                                              IsChecked="False"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand" Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="8">
                                                <Path x:Name="ar" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" CenterX="4" CenterY="2"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ar" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" CenterX="4" CenterY="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <StackPanel Visibility="{Binding IsChecked, ElementName=InventoryToggle, Converter={StaticResource BoolToVisConverter}}">
                                <Button Style="{StaticResource SubNav}" Command="{Binding NavigateToAddItemCommand}">
                                    <TextBlock Text="Add Item" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Button>
                            </StackPanel>

                            <Button Command="{Binding NavigateToSentimentSearchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="SentimentSearch">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❝❞" FontSize="11" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Sentiment Search" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToInspirationCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Inspiration">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✦" FontSize="13" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Inspiration" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToWishlistCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Wishlist">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="♡" FontSize="13" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Wish List" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToColorMatchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="ColorMatch">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Color Match" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToEnvelopeExpertCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="EnvelopeExpert">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✉" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Envelope &amp; Box" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToSocialCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Social">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❀" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Social" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- PROJECTS -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding NavigateToProjectsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentPage}" Value="Projects">
                                                    <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✿" FontSize="13" Margin="2,0,10,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Projects" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ToggleButton Grid.Column="1" x:Name="ProjectsToggle"
                                              IsChecked="False"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand" Focusable="False">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="8">
                                                <Path x:Name="ar" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" CenterX="4" CenterY="2"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ar" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" CenterX="4" CenterY="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <StackPanel Visibility="{Binding IsChecked, ElementName=ProjectsToggle, Converter={StaticResource BoolToVisConverter}}">
                                <Button Style="{StaticResource SubNav}" Command="{Binding NavigateToAddProjectCommand}">
                                    <TextBlock Text="Add Project" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Button>
                            </StackPanel>

                            <!-- REPORTS -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource SidebarSectionHeader}"
                                           Text="REPORTS"/>
                                <ToggleButton Grid.Column="1" x:Name="ReportsToggle"
                                              IsChecked="False"
                                              Background="Transparent" BorderThickness="0"
                                              Cursor="Hand" Focusable="False"
                                              Margin="0,18,8,6">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="8">
                                                <Path x:Name="ar" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" CenterX="4" CenterY="2"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ar" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" CenterX="4" CenterY="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <StackPanel Visibility="{Binding IsChecked, ElementName=ReportsToggle, Converter={StaticResource BoolToVisConverter}}">

                            <Button Command="{Binding NavigateToStockTrackingCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="Stock">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◐" FontSize="13" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Stock Tracker" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavigateToPurchaseReportCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SideNav}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPage}" Value="PurchaseReport">
                                                <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="$" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Expense Report" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SideNav}" Command="{Binding OpenExportDialogCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↧" FontSize="14" Margin="2,0,10,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Export Data" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── CONTENT ─────────────────────────────────── -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
